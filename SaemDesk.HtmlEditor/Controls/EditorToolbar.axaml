<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaemDesk.HtmlEditor.EditorToolbar">

  <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="2">
    <WrapPanel>
      <Button x:Name="BoldBtn" Content="B" FontWeight="Bold"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="굵게" />
      <Button x:Name="ItalicBtn" Content="I" FontStyle="Italic"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="기울임" />
      <Button x:Name="UnderlineBtn" Content="U"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="밑줄">
        <Button.Styles>
          <Style Selector="Button#UnderlineBtn > TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
          </Style>
        </Button.Styles>
      </Button>
      <Button x:Name="StrikeBtn" Content="S"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="취소선">
        <Button.Styles>
          <Style Selector="Button#StrikeBtn > TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough" />
          </Style>
        </Button.Styles>
      </Button>

      <Separator Width="1" Background="LightGray" Margin="3,2" />

      <Button x:Name="FontSizeBtn" Content="크기" FontSize="11"
              Height="28" Padding="6,0" Margin="1"
              Focusable="False" ToolTip.Tip="글꼴 크기" />

      <Button x:Name="ColorBtn" Content="색상" FontSize="11"
              Height="28" Padding="6,0" Margin="1"
              Focusable="False" ToolTip.Tip="글자 색상" />

      <Separator Width="1" Background="LightGray" Margin="3,2" />

      <Button x:Name="AlignLeftBtn" Content="&#x2261;"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="왼쪽 정렬" />
      <Button x:Name="AlignCenterBtn" Content="&#x2550;"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="가운데 정렬" />
      <Button x:Name="AlignRightBtn" Content="&#x2192;"
              Width="28" Height="28" Padding="0" Margin="1"
              Focusable="False" ToolTip.Tip="오른쪽 정렬" />

      <Separator Width="1" Background="LightGray" Margin="3,2" />

      <Button x:Name="ImageBtn" Content="이미지" FontSize="11"
              Height="28" Padding="6,0" Margin="1"
              Focusable="False" ToolTip.Tip="이미지 삽입" />

      <Button x:Name="TableBtn" Content="표" FontSize="11"
              Height="28" Padding="6,0" Margin="1"
              Focusable="False" ToolTip.Tip="표 삽입" />
    </WrapPanel>
  </Border>

</UserControl>
