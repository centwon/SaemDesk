<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SaemDesk.HtmlEditor"
             x:Class="SaemDesk.HtmlEditor.HtmlEditorControl">

  <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
    <Grid RowDefinitions="Auto,*">
      <local:EditorToolbar x:Name="Toolbar" Grid.Row="0" />
      <local:EditArea x:Name="EditArea" Grid.Row="1" MinHeight="200" />
    </Grid>
  </Border>

</UserControl>
