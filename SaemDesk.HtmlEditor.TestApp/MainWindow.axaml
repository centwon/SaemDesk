<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:SaemDesk.HtmlEditor;assembly=SaemDesk.HtmlEditor"
        x:Class="SaemDesk.HtmlEditor.TestApp.MainWindow"
        Title="HtmlEditor Test" Width="900" Height="700">

  <Grid RowDefinitions="*,Auto,*">

    <!-- 상단: 에디터 -->
    <editor:HtmlEditorControl x:Name="Editor" Grid.Row="0" Margin="8" />

    <!-- 중간: HTML 출력 버튼 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Center" Margin="4">
      <Button x:Name="ShowHtmlBtn" Content="HTML 보기" Margin="4" />
      <Button x:Name="LoadSampleBtn" Content="샘플 로드" Margin="4" />
    </StackPanel>

    <!-- 하단: HTML 소스 확인 -->
    <TextBox x:Name="HtmlOutput" Grid.Row="2" Margin="8"
             AcceptsReturn="True" IsReadOnly="True"
             TextWrapping="Wrap" FontFamily="Consolas"
             PlaceholderText="HTML 출력이 여기에 표시됩니다" />
  </Grid>

</Window>
