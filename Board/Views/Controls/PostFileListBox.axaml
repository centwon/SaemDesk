<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SaemDesk.Board.Views.Controls"
             x:Class="SaemDesk.Board.Views.Controls.PostFileListBox">

  <UserControl.Styles>
    <!-- 파일 버튼 스타일: 파란 계열 배경 -->
    <Style Selector="Button.fileBtn">
      <Setter Property="Background" Value="#E3F0FB"/>
      <Setter Property="BorderBrush" Value="#7BB8E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#1A5C9A"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.fileBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C8E1F7"/>
    </Style>
    <Style Selector="Button.fileBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#A8CFF0"/>
    </Style>
  </UserControl.Styles>

  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1" CornerRadius="6" Padding="8">
    <Grid RowDefinitions="Auto,*">

      <!-- 헤더 + 버튼 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
        <TextBlock x:Name="HeaderText"
                   Grid.Column="0"
                   Text="파일을 끌어 놓거나 '+' 버튼을 눌러 추가하세요"
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   VerticalAlignment="Center"/>
        <Button x:Name="BtnAdd"    Grid.Column="1" Content="+"  Padding="8,4" Margin="4,0,0,0" Click="BtnAdd_Click"/>
        <Button x:Name="BtnRemove" Grid.Column="2" Content="−"  Padding="8,4" Margin="4,0,0,0" Click="BtnRemove_Click"/>
        <Button x:Name="BtnFolder" Grid.Column="3" Content="📁" Padding="8,4" Margin="4,0,0,0" Click="BtnFolder_Click"/>
      </Grid>

      <!-- 드롭 영역 + 파일 목록 -->
      <Border Grid.Row="1"
              x:Name="DropArea"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="4"
              MinHeight="60"
              IsHitTestVisible="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      MaxHeight="120" Padding="4">
          <ItemsControl x:Name="FileItems">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ctrl:FileBoxItem">
                <StackPanel Orientation="Horizontal" Margin="3,3,0,0" Spacing="2">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsVisible="{Binding ShowCheckBox}"
                            VerticalAlignment="Center"
                            Padding="0"/>
                  <Button Classes="fileBtn"
                          Content="{Binding Label}"
                          Cursor="Hand"
                          ToolTip.Tip="{Binding PostFile.FileName}"
                          Click="OnFileButtonClick"
                          Tag="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

    </Grid>
  </Border>
</UserControl>
