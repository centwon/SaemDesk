<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SaemDesk.Board.Models"
             x:Class="SaemDesk.Board.Views.Controls.PostFileListBox">

  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1" CornerRadius="6" Padding="8">
    <Grid RowDefinitions="Auto,Auto,*">

      <!-- 헤더 + 버튼 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
        <TextBlock x:Name="HeaderText"
                   Grid.Column="0"
                   Text="파일을 끌어 놓거나 '+' 버튼을 눌러 추가하세요"
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   VerticalAlignment="Center"/>
        <Button x:Name="BtnAdd"    Grid.Column="1" Content="+"  Padding="8,4" Margin="4,0,0,0" Click="BtnAdd_Click"/>
        <Button x:Name="BtnRemove" Grid.Column="2" Content="−"  Padding="8,4" Margin="4,0,0,0" Click="BtnRemove_Click"/>
        <Button x:Name="BtnFolder" Grid.Column="3" Content="📁" Padding="8,4" Margin="4,0,0,0" Click="BtnFolder_Click"/>
      </Grid>

      <!-- 드롭 영역 안내 -->
      <Border Grid.Row="1"
              x:Name="DropArea"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="4"
              Padding="8,4" Margin="0,0,0,6"
              IsHitTestVisible="True"/>

      <!-- 파일 목록 -->
      <ScrollViewer Grid.Row="2" MaxHeight="150" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="FileItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:PostFile">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                <CheckBox Grid.Column="0" x:Name="ChkFile" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                           VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}"
                           VerticalAlignment="Center" FontSize="11" Margin="8,0,8,0"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                <Button Grid.Column="3" Content="열기" Padding="6,2" FontSize="11"
                        Click="BtnOpenFile_Click" Tag="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
