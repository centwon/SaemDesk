<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.Board.ViewModels"
             xmlns:models="using:SaemDesk.Board.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             xmlns:boardCtrl="using:SaemDesk.Board.Views.Controls"
             x:Class="SaemDesk.Board.Views.Pages.PostDetailPage"
             x:DataType="vm:PostDetailViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- ── 툴바 ─────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                Margin="16,10,16,0">
      <Button Content="◀ 목록"  Padding="10,5" Click="BtnBack_Click"/>
      <Button Content="수정"     Padding="10,5" Click="BtnEdit_Click"/>
      <Button Content="삭제"     Padding="10,5" Click="BtnDelete_Click"/>
      <Button Content="인쇄"     Padding="10,5" Click="BtnPrint_Click"/>
    </StackPanel>

    <!-- ── 본문 ─────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Margin="16,8,16,16">
      <StackPanel Spacing="12">

        <!-- 로딩 -->
        <ProgressBar IsVisible="{Binding IsLoading}"
                     IsIndeterminate="True"/>

        <!-- 제목 + 메타 -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Post.Title}"
                     FontSize="20" FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Post.Category}"  FontSize="12"
                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
            <TextBlock Text="{Binding Post.Subject}"   FontSize="12"
                       IsVisible="{Binding SubjectVisible}"
                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
            <TextBlock Text="{Binding Post.User}"      FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
            <TextBlock Text="{Binding Post.DateTimeDisplay}" FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
            <TextBlock Text="{Binding Post.ReadCount, StringFormat=조회 \{0\}}" FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
          </StackPanel>
        </StackPanel>

        <Separator/>

        <!-- 내용 (JoditEditor ReadOnly) -->
        <ctrl:JoditEditor x:Name="ContentViewer" MinHeight="200"/>

        <!-- 첨부파일 -->
        <boardCtrl:PostFileListBox x:Name="FileListBox" IsVisible="False"/>

        <Separator/>

        <!-- 댓글 목록 -->
        <StackPanel Spacing="0">
          <TextBlock Text="댓글" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

          <ItemsControl ItemsSource="{Binding Comments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:Comment">
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding User}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding DateTime, StringFormat=\{0:M/d HH:mm\}}"
                                   FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"/>
                      <Button Content="📎 파일 열기" Padding="6,2" FontSize="11"
                              IsVisible="{Binding HasFile}"
                              Tag="{Binding}"
                              Click="BtnOpenCommentFile_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <Button Content="수정" Padding="6,2" FontSize="11"
                              Tag="{Binding}" Click="BtnEditComment_Click"/>
                      <Button Content="삭제" Padding="6,2" FontSize="11"
                              Tag="{Binding}" Click="BtnDeleteComment_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 댓글 작성 -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock x:Name="CommentEditTitle" Text="댓글 작성" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtComment"
                     Text="{Binding NewCommentContent, Mode=TwoWay}"
                     PlaceholderText="댓글 내용을 입력하세요"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="60" MaxHeight="150"/>
            <!-- 파일 첨부 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="📎 파일 첨부" Padding="8,4" Click="BtnAttachFile_Click"/>
              <TextBlock x:Name="AttachedFileName" VerticalAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource SystemBaseMediumColor}"/>
              <Button x:Name="BtnRemoveAttach" Content="✕" Padding="4,2" IsVisible="False"
                      Click="BtnRemoveAttach_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="BtnCancelEdit" Content="수정 취소" IsVisible="False"
                      Padding="10,5" Click="BtnCancelEdit_Click"/>
              <Button x:Name="BtnSaveComment" Content="댓글 작성" Classes="accent"
                      Padding="10,5" Click="BtnSaveComment_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
