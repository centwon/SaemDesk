<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:boardCtrl="using:SaemDesk.Board.Views.Controls"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Board.Views.Pages.PostEditPage">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── 툴바 (제목 · 카테고리 · 주제 · 명렬표 삽입 한 줄) ── -->
    <Grid Grid.Row="0" Margin="16,10,16,0"
          ColumnDefinitions="Auto,Auto,Auto,*,Auto">
      <!-- 페이지 제목 -->
      <TextBlock Grid.Column="0" x:Name="PageTitle" Text="새 글 쓰기"
                 FontSize="18" FontWeight="SemiBold"
                 VerticalAlignment="Bottom" Margin="0,0,16,0"/>
      <!-- 카테고리 -->
      <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,10,0">
        <TextBlock Text="카테고리" FontSize="10"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <ComboBox x:Name="CBoxCategory" MinWidth="140"
                  SelectionChanged="OnCategoryChanged"/>
      </StackPanel>
      <!-- 주제 -->
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock Text="주제" FontSize="10"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <ComboBox x:Name="CBoxSubject" MinWidth="160"
                  SelectionChanged="OnSubjectChanged"/>
      </StackPanel>
      <!-- 명렬표 삽입 -->
      <Button Grid.Column="4" x:Name="BtnInsertRoster" Content="명렬표 삽입"
              Padding="10,5" VerticalAlignment="Bottom"
              ToolTip.Tip="학급/수업/동아리 명렬표 HTML 표 삽입"
              Click="BtnInsertRoster_Click"/>
    </Grid>

    <!-- ── 폼 ───────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Margin="16,8,16,0">
      <StackPanel Spacing="10">

        <!-- 제목 -->
        <StackPanel Spacing="2">
          <TextBlock Text="제목" FontSize="10"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>
          <TextBox x:Name="TxtTitle" PlaceholderText="제목을 입력하세요"/>
        </StackPanel>

        <!-- 내용 (JoditEditor) -->
        <StackPanel Spacing="2">
          <TextBlock Text="내용" FontSize="10"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>
          <ctrl:JoditEditor x:Name="ContentEditor" MinHeight="300"/>
        </StackPanel>

        <!-- 첨부파일 -->
        <boardCtrl:PostFileListBox x:Name="FileListBox"/>

      </StackPanel>
    </ScrollViewer>

    <!-- ── 하단 버튼 ─────────────────────────────────────── -->
    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8"
                Margin="16,8,16,12">
      <Button Content="취소"  Padding="14,7" Click="BtnCancel_Click"/>
      <Button x:Name="BtnSave" Content="저장" Classes="accent"
              Padding="14,7" Click="BtnSave_Click"
              HotKey="Ctrl+S"
              ToolTip.Tip="저장 (Ctrl+S)"/>
    </StackPanel>

  </Grid>
</UserControl>
