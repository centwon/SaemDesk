<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════
       브랜드 색상 — 라이트/다크 공통
       ═══════════════════════════════════════════════════════ -->
  <Color x:Key="BrandPrimary">#0078D4</Color>
  <Color x:Key="BrandSecondary">#005A9E</Color>
  <Color x:Key="BrandAccent">#50E6FF</Color>

  <SolidColorBrush x:Key="BrandPrimaryBrush"         Color="{StaticResource BrandPrimary}" />
  <SolidColorBrush x:Key="BrandSecondaryBrush"        Color="{StaticResource BrandSecondary}" />
  <SolidColorBrush x:Key="BrandAccentBrush"           Color="{StaticResource BrandAccent}" />
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="{StaticResource BrandPrimary}" />

  <!-- ═══════════════════════════════════════════════════════
       테마별 색상
       ═══════════════════════════════════════════════════════ -->
  <ResourceDictionary.ThemeDictionaries>

    <!-- ─── 라이트 모드 ─────────────────────────────────── -->
    <ResourceDictionary x:Key="Light">

      <!-- 버튼 배경 → 투명 -->
      <SolidColorBrush x:Key="ButtonBackground"              Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver"    Color="#08000000" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed"        Color="#12000000" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled"       Color="Transparent" />

      <!-- 입력 컨트롤 배경 → 투명 -->
      <SolidColorBrush x:Key="TextControlBackground"              Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver"    Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused"        Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBackground"                  Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"       Color="Transparent" />

      <!-- 달력 배경 → 투명 -->
      <SolidColorBrush x:Key="CalendarItemBackground"              Color="Transparent" />
      <SolidColorBrush x:Key="CalendarDayButtonBackground"         Color="Transparent" />
      <SolidColorBrush x:Key="CalendarButtonBackground"            Color="Transparent" />
      <SolidColorBrush x:Key="CalendarItemBorderBrush"             Color="#E0E0E0" />

      <!-- 네비게이션 패널 -->
      <SolidColorBrush x:Key="NavBackgroundBrush"    Color="#F3F3F3" />
      <SolidColorBrush x:Key="NavItemHoverBrush"     Color="#E5E5E5" />
      <SolidColorBrush x:Key="NavItemSelectedBrush"  Color="#DDEEFF" />

      <!-- 콘텐츠 영역 -->
      <SolidColorBrush x:Key="ContentBackgroundBrush"  Color="#FFFFFF" />
      <SolidColorBrush x:Key="ContentSeparatorBrush"   Color="#E0E0E0" />

      <!-- 시맨틱: 상태 색상 -->
      <SolidColorBrush x:Key="ErrorForegroundBrush"    Color="#D9372A" />
      <SolidColorBrush x:Key="WarningForegroundBrush"  Color="#E08F2A" />
      <SolidColorBrush x:Key="SuccessForegroundBrush"  Color="#0F9D58" />
      <SolidColorBrush x:Key="SecondaryAccentBrush"    Color="#5B7FB8" />

      <!-- 시맨틱: 표면 색상 -->
      <SolidColorBrush x:Key="InfoSurfaceBrush"        Color="#F0F4FF" />
      <SolidColorBrush x:Key="InfoBorderBrush"         Color="#C5D0F0" />
      <SolidColorBrush x:Key="InfoForegroundBrush"     Color="#3F51B5" />
      <SolidColorBrush x:Key="InfoMutedBrush"          Color="#7986CB" />
      <SolidColorBrush x:Key="SelectedRowBrush"        Color="#E3F2FD" />
      <SolidColorBrush x:Key="WarningSurfaceBrush"     Color="#FFF3E0" />
      <SolidColorBrush x:Key="WarningDarkBrush"        Color="#E65100" />
      <SolidColorBrush x:Key="SuccessSurfaceBrush"     Color="#E8F5E9" />
      <SolidColorBrush x:Key="SuccessDarkBrush"        Color="#2E7D32" />

      <!-- 카드 헤더 -->
      <SolidColorBrush x:Key="CardHeaderBrush"         Color="#E6E6FA" />
      <SolidColorBrush x:Key="CardHeaderBorderBrush"   Color="#6495ED" />

      <!-- 오버레이 -->
      <SolidColorBrush x:Key="LoadingOverlayBrush"     Color="#33000000" />

    </ResourceDictionary>

    <!-- ─── 다크 모드 ──────────────────────────────────── -->
    <ResourceDictionary x:Key="Dark">

      <!-- 버튼 배경 → 투명 -->
      <SolidColorBrush x:Key="ButtonBackground"              Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver"    Color="#12FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed"        Color="#18FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled"       Color="Transparent" />

      <!-- 입력 컨트롤 배경 → 투명 -->
      <SolidColorBrush x:Key="TextControlBackground"              Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver"    Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused"        Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBackground"                  Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"       Color="Transparent" />

      <!-- 달력 배경 → 투명 -->
      <SolidColorBrush x:Key="CalendarItemBackground"              Color="Transparent" />
      <SolidColorBrush x:Key="CalendarDayButtonBackground"         Color="Transparent" />
      <SolidColorBrush x:Key="CalendarButtonBackground"            Color="Transparent" />
      <SolidColorBrush x:Key="CalendarItemBorderBrush"             Color="#3A3A3A" />

      <!-- 네비게이션 패널 -->
      <SolidColorBrush x:Key="NavBackgroundBrush"    Color="#1E1E1E" />
      <SolidColorBrush x:Key="NavItemHoverBrush"     Color="#2D2D2D" />
      <SolidColorBrush x:Key="NavItemSelectedBrush"  Color="#1B3D5A" />

      <!-- 콘텐츠 영역 -->
      <SolidColorBrush x:Key="ContentBackgroundBrush"  Color="#141414" />
      <SolidColorBrush x:Key="ContentSeparatorBrush"   Color="#3A3A3A" />

      <!-- 시맨틱: 상태 색상 -->
      <SolidColorBrush x:Key="ErrorForegroundBrush"    Color="#EF5350" />
      <SolidColorBrush x:Key="WarningForegroundBrush"  Color="#FFB74D" />
      <SolidColorBrush x:Key="SuccessForegroundBrush"  Color="#66BB6A" />
      <SolidColorBrush x:Key="SecondaryAccentBrush"    Color="#7BA4D9" />

      <!-- 시맨틱: 표면 색상 -->
      <SolidColorBrush x:Key="InfoSurfaceBrush"        Color="#1A2332" />
      <SolidColorBrush x:Key="InfoBorderBrush"         Color="#2A3552" />
      <SolidColorBrush x:Key="InfoForegroundBrush"     Color="#7986CB" />
      <SolidColorBrush x:Key="InfoMutedBrush"          Color="#9FA8DA" />
      <SolidColorBrush x:Key="SelectedRowBrush"        Color="#1A3050" />
      <SolidColorBrush x:Key="WarningSurfaceBrush"     Color="#2D1F0A" />
      <SolidColorBrush x:Key="WarningDarkBrush"        Color="#FF8A50" />
      <SolidColorBrush x:Key="SuccessSurfaceBrush"     Color="#0D2818" />
      <SolidColorBrush x:Key="SuccessDarkBrush"        Color="#4CAF50" />

      <!-- 카드 헤더 -->
      <SolidColorBrush x:Key="CardHeaderBrush"         Color="#2A2A3E" />
      <SolidColorBrush x:Key="CardHeaderBorderBrush"   Color="#4A6DA8" />

      <!-- 오버레이 -->
      <SolidColorBrush x:Key="LoadingOverlayBrush"     Color="#55000000" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
