<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════
       브랜드 색상 — Semi Primary 팔레트 기준 (라이트/다크 공통)
       ═══════════════════════════════════════════════════════ -->
  <Color x:Key="BrandPrimary">#0064FA</Color>
  <Color x:Key="BrandSecondary">#004FB3</Color>
  <Color x:Key="BrandAccent">#54A9FF</Color>

  <SolidColorBrush x:Key="BrandPrimaryBrush"         Color="{StaticResource BrandPrimary}" />
  <SolidColorBrush x:Key="BrandSecondaryBrush"        Color="{StaticResource BrandSecondary}" />
  <SolidColorBrush x:Key="BrandAccentBrush"           Color="{StaticResource BrandAccent}" />
  <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="{StaticResource BrandPrimary}" />

  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

  <!-- ═══════════════════════════════════════════════════════
       테마별 색상 — 값은 Semi 팔레트(실측)에 맞춘 고정 hex.
       (DynamicResource 미사용: Semi 토큰 타입 혼재로 인한 캐스트 오류 방지)
       ═══════════════════════════════════════════════════════ -->
  <ResourceDictionary.ThemeDictionaries>

    <!-- ─── 라이트 모드 (Semi Light) ───────────────────── -->
    <ResourceDictionary x:Key="Light">

      <!-- Fluent 호환 키 -->
      <Color x:Key="SystemBaseMediumColor">#FF6B7075</Color>
      <Color x:Key="SystemBaseMediumLowColor">#FF9AA0A6</Color>
      <Color x:Key="SystemBaseLowColor">#FFC8CDD2</Color>
      <Color x:Key="SystemListLowColor">#FFF7F8FA</Color>
      <Color x:Key="SystemListMediumColor">#FFEDEEF0</Color>
      <Color x:Key="SystemAccentColor">#FF0064FA</Color>
      <Color x:Key="SystemAccentColorDark1">#FF004FB3</Color>
      <Color x:Key="SystemErrorTextColor">#FFF93920</Color>
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"      Color="#FF1C1F23" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"     Color="#FF6B7075" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush"  Color="#FF9AA0A6" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"        Color="#FFE5E6E8" />
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"        Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush"        Color="#FFF7F8FA" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeLowBrush"      Color="#FFF0F1F3" />
      <SolidColorBrush x:Key="TextControlForeground"                      Color="#FF1C1F23" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver"          Color="#FFF0F1F3" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPressed"              Color="#FFE5E6E8" />

      <!-- 네비게이션 패널 -->
      <SolidColorBrush x:Key="NavBackgroundBrush"    Color="#FFF7F8FA" />
      <SolidColorBrush x:Key="NavItemHoverBrush"     Color="#FFEDEEF0" />
      <SolidColorBrush x:Key="NavItemSelectedBrush"  Color="#FFEAF5FF" />

      <!-- 콘텐츠 영역 -->
      <SolidColorBrush x:Key="ContentBackgroundBrush"  Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ContentSeparatorBrush"   Color="#FFE5E6E8" />

      <!-- 시맨틱: 상태 색상 (Semi) -->
      <SolidColorBrush x:Key="ErrorForegroundBrush"    Color="#FFF93920" />
      <SolidColorBrush x:Key="WarningForegroundBrush"  Color="#FFFC8800" />
      <SolidColorBrush x:Key="SuccessForegroundBrush"  Color="#FF3BB346" />
      <SolidColorBrush x:Key="SecondaryAccentBrush"    Color="#FF0064FA" />

      <!-- 시맨틱: 표면 색상 (Semi Light 변형 = 옅은 틴트) -->
      <SolidColorBrush x:Key="InfoSurfaceBrush"        Color="#FFEAF5FF" />
      <SolidColorBrush x:Key="InfoBorderBrush"         Color="#FFB3D4FF" />
      <SolidColorBrush x:Key="InfoForegroundBrush"     Color="#FF0064FA" />
      <SolidColorBrush x:Key="InfoMutedBrush"          Color="#FF6B7075" />
      <SolidColorBrush x:Key="SelectedRowBrush"        Color="#FFEAF5FF" />
      <SolidColorBrush x:Key="WarningSurfaceBrush"     Color="#FFFFF8EA" />
      <SolidColorBrush x:Key="WarningDarkBrush"        Color="#FFC25A00" />
      <SolidColorBrush x:Key="SuccessSurfaceBrush"     Color="#FFECF7EC" />
      <SolidColorBrush x:Key="SuccessDarkBrush"        Color="#FF2A8F33" />

      <!-- 카드 헤더 (라벤더 → Semi 중립 회색) -->
      <SolidColorBrush x:Key="CardHeaderBrush"         Color="#FFF2F3F5" />
      <SolidColorBrush x:Key="CardHeaderBorderBrush"   Color="#FFE5E6E8" />

      <!-- 오버레이 -->
      <SolidColorBrush x:Key="LoadingOverlayBrush"     Color="#33000000" />

    </ResourceDictionary>

    <!-- ─── 다크 모드 (Semi Dark) ──────────────────────── -->
    <ResourceDictionary x:Key="Dark">

      <!-- Fluent 호환 키 -->
      <Color x:Key="SystemBaseMediumColor">#FF888D92</Color>
      <Color x:Key="SystemBaseMediumLowColor">#FF6E7378</Color>
      <Color x:Key="SystemBaseLowColor">#FF4F5159</Color>
      <Color x:Key="SystemListLowColor">#FF1E1F24</Color>
      <Color x:Key="SystemListMediumColor">#FF2A2B30</Color>
      <Color x:Key="SystemAccentColor">#FF54A9FF</Color>
      <Color x:Key="SystemAccentColorDark1">#FFA9D7FF</Color>
      <Color x:Key="SystemErrorTextColor">#FFFC725A</Color>
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"      Color="#FFF9F9F9" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"     Color="#FF888D92" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush"  Color="#FF6E7378" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"        Color="#FF35363C" />
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"        Color="#FF232429" />
      <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush"        Color="#FF1E1F24" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeLowBrush"      Color="#FF2A2B30" />
      <SolidColorBrush x:Key="TextControlForeground"                      Color="#FFF9F9F9" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver"          Color="#FF2A2B30" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPressed"              Color="#FF35363C" />

      <!-- 네비게이션 패널 -->
      <SolidColorBrush x:Key="NavBackgroundBrush"    Color="#FF1B1C20" />
      <SolidColorBrush x:Key="NavItemHoverBrush"     Color="#FF2A2B30" />
      <SolidColorBrush x:Key="NavItemSelectedBrush"  Color="#FF18324D" />

      <!-- 콘텐츠 영역 -->
      <SolidColorBrush x:Key="ContentBackgroundBrush"  Color="#FF16161A" />
      <SolidColorBrush x:Key="ContentSeparatorBrush"   Color="#FF35363C" />

      <!-- 시맨틱: 상태 색상 (Semi) -->
      <SolidColorBrush x:Key="ErrorForegroundBrush"    Color="#FFFC725A" />
      <SolidColorBrush x:Key="WarningForegroundBrush"  Color="#FFFFAE43" />
      <SolidColorBrush x:Key="SuccessForegroundBrush"  Color="#FF5DC264" />
      <SolidColorBrush x:Key="SecondaryAccentBrush"    Color="#FF54A9FF" />

      <!-- 시맨틱: 표면 색상 -->
      <SolidColorBrush x:Key="InfoSurfaceBrush"        Color="#FF18324D" />
      <SolidColorBrush x:Key="InfoBorderBrush"         Color="#FF2A4A6B" />
      <SolidColorBrush x:Key="InfoForegroundBrush"     Color="#FF54A9FF" />
      <SolidColorBrush x:Key="InfoMutedBrush"          Color="#FF888D92" />
      <SolidColorBrush x:Key="SelectedRowBrush"        Color="#FF18324D" />
      <SolidColorBrush x:Key="WarningSurfaceBrush"     Color="#FF2E2310" />
      <SolidColorBrush x:Key="WarningDarkBrush"        Color="#FFFFAE43" />
      <SolidColorBrush x:Key="SuccessSurfaceBrush"     Color="#FF15281A" />
      <SolidColorBrush x:Key="SuccessDarkBrush"        Color="#FF5DC264" />

      <!-- 카드 헤더 -->
      <SolidColorBrush x:Key="CardHeaderBrush"         Color="#FF232429" />
      <SolidColorBrush x:Key="CardHeaderBorderBrush"   Color="#FF35363C" />

      <!-- 오버레이 -->
      <SolidColorBrush x:Key="LoadingOverlayBrush"     Color="#55000000" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
