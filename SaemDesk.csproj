<Project Sdk="Microsoft.NET.Sdk">
  <!-- secrets.props 가 있으면 빌드 시 API 키 주입 (git 제외 파일) -->
  <Import Project="secrets.props" Condition="Exists('secrets.props')" />
  <PropertyGroup>
    <!-- secrets.props 미존재 시 빈 값 기본값 -->
    <GoogleClientId    Condition="'$(GoogleClientId)'==''"></GoogleClientId>
    <GoogleClientSecret Condition="'$(GoogleClientSecret)'==''"></GoogleClientSecret>
    <NeisApiKey         Condition="'$(NeisApiKey)'==''"></NeisApiKey>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 코드로만 생성하는 다이얼로그의 무매개변수 생성자 경고 억제 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>

    <!-- 앱 메타데이터 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>SaemDesk</Product>
    <Company>Centwons</Company>
    <Description>학교 업무 통합 데스크탑 — 학생·수업·학급일지·게시판·스케줄러·NEIS·Google Calendar.</Description>
    <Copyright>© 2026 Centwons</Copyright>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);SaemDesk.HtmlEditor\**;SaemDesk.HtmlEditor.TestApp\**</DefaultItemExcludes>
  </PropertyGroup>
<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
  <PublishAot>false</PublishAot>
</PropertyGroup>
  <ItemGroup>
    <!-- Assets 폴더를 포함하되, axaml 파일은 자동 포함되므로 여기서 제외 -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.axaml" />  
  </ItemGroup>

  <ItemGroup>
    <None Include="secrets.props.template" />
  </ItemGroup>

  <!-- 빌드 시 API 키를 C# 소스로 생성하여 바이너리에 내장 -->
  <Target Name="GenerateSecrets" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_SecretsGenDir>$(IntermediateOutputPath)Generated\</_SecretsGenDir>
    </PropertyGroup>
    <MakeDir Directories="$(_SecretsGenDir)" />
    <WriteLinesToFile File="$(_SecretsGenDir)BuildSecrets.g.cs" Overwrite="true" Lines="
// &lt;auto-generated&gt; 빌드 시 secrets.props 로부터 생성됨. 수정 금지. &lt;/auto-generated&gt;
namespace SaemDesk.Services%3B
internal static class BuildSecrets
{
    internal const string GoogleClientId     = &quot;$(GoogleClientId)&quot;%3B
    internal const string GoogleClientSecret = &quot;$(GoogleClientSecret)&quot;%3B
    internal const string NeisApiKey          = &quot;$(NeisApiKey)&quot;%3B
}" />
    <ItemGroup>
      <Compile Include="$(_SecretsGenDir)BuildSecrets.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Database -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- UI 테마 -->
    <PackageReference Include="Semi.Avalonia" Version="12.0.3" />
    <!-- Export -->
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="MiniExcel" Version="1.44.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- Windows: DPAPI token encryption -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
  </ItemGroup>
</Project>
