<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaemDesk.Views.Controls.TimetableControl"
             ClipToBounds="True">
  <Grid Name="TimetableGrid"
        Background="Transparent"
        ColumnSpacing="0" RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="36"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 좌상단 빈 셀 -->
    <Border Grid.Row="0" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1"/>

    <!-- 요일 헤더 -->
    <Border Name="HdrMon" Grid.Row="0" Grid.Column="1" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Name="TxtMon" Text="월"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Name="HdrTue" Grid.Row="0" Grid.Column="2" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Name="TxtTue" Text="화"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Name="HdrWed" Grid.Row="0" Grid.Column="3" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Name="TxtWed" Text="수"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Name="HdrThu" Grid.Row="0" Grid.Column="4" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Name="TxtThu" Text="목"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Name="HdrFri" Grid.Row="0" Grid.Column="5" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <TextBlock Name="TxtFri" Text="금"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold"/>
    </Border>

    <!-- 교시 라벨 열 -->
    <Border Grid.Row="1" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Grid.Row="2" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Grid.Row="3" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Grid.Row="4" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Grid.Row="5" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Grid.Row="6" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,1">
      <TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <Border Grid.Row="7" Grid.Column="0" Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,0">
      <TextBlock Text="7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>
