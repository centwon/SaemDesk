<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sched="using:SaemDesk.Scheduler"
             x:Class="SaemDesk.Views.Controls.KAgendaControl">

  <Border Classes="elevated"
          BorderBrush="{DynamicResource CardHeaderBorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="36,*">

      <!-- ── 헤더 (필터/추가) ────────────────────── -->
      <Border Grid.Row="0"
              Background="{DynamicResource CardHeaderBrush}"
              BorderBrush="{DynamicResource ContentSeparatorBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0">
        <Grid Margin="8,4" ColumnDefinitions="Auto,Auto,8,Auto,4,Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="📋"
                     FontSize="14" VerticalAlignment="Center"
                     Margin="0,0,6,0"/>

          <ComboBox Grid.Column="1"
                    x:Name="CBoxFilter"
                    Height="24" MinHeight="24" FontSize="11" MinWidth="86"
                    Padding="6,0"
                    VerticalAlignment="Center"
                    SelectionChanged="OnCalendarFilterChanged"/>

          <ToggleButton Grid.Column="3"
                        x:Name="TbTask"
                        Content="✓ 할 일"
                        IsChecked="True"
                        Height="24" MinHeight="24" FontSize="11"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        IsCheckedChanged="OnTypeFilterChanged"/>

          <ToggleButton Grid.Column="5"
                        x:Name="TbEvent"
                        Content="📅 일정"
                        IsChecked="True"
                        Height="24" MinHeight="24" FontSize="11"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        IsCheckedChanged="OnTypeFilterChanged"/>

          <Button Grid.Column="7"
                  x:Name="BtnAdd"
                  Content="＋ 추가"
                  Click="OnAddClicked"
                  Height="24" MinHeight="24" FontSize="12"
                  Padding="10,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="새 항목 추가"/>
        </Grid>
      </Border>

      <!-- ── 빈 상태 표시 ─────────────────────────── -->
      <TextBlock Grid.Row="1"
                 x:Name="EmptyText"
                 Text="표시할 항목이 없습니다."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource SystemBaseMediumLowColor}"
                 IsVisible="False"/>

      <!-- ── 본문 (헤더 + 항목 평탄 리스트) ─────── -->
      <ListBox Grid.Row="1"
               x:Name="AgendaListBox"
               SelectionMode="Single"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          </Style>
        </ListBox.Styles>

        <ListBox.DataTemplates>

          <!-- 날짜 헤더 -->
          <DataTemplate DataType="sched:AgendaHeader">
            <Border Padding="8,5,8,3"
                    Background="{DynamicResource InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DateHeader}"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource InfoForegroundBrush}"/>
                <TextBlock Text="{Binding CountLabel}"
                           FontSize="11"
                           Foreground="{DynamicResource InfoMutedBrush}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- 항목 -->
          <DataTemplate DataType="sched:AgendaItem">
            <Grid Margin="8,4" MinHeight="32"
                  ColumnDefinitions="18,60,*,Auto,Auto"
                  PointerPressed="OnAgendaItemPressed"
                  Tag="{Binding}"
                  Background="Transparent">

              <TextBlock Grid.Column="0"
                         Text="{Binding TypeIcon}"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Foreground="{Binding AccentBrush}"/>

              <TextBlock Grid.Column="1"
                         Text="{Binding TimeLabel}"
                         FontSize="10"
                         Foreground="#777"
                         VerticalAlignment="Center"
                         Margin="2,0,4,0"/>

              <TextBlock Grid.Column="2"
                         Text="{Binding Title}"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Center"
                         Opacity="{Binding TitleOpacity}"
                         Classes.strike="{Binding IsStrikethrough}"/>

              <Border Grid.Column="3"
                      CornerRadius="3"
                      Padding="5,1"
                      Margin="4,0,2,0"
                      Height="20"
                      Background="{Binding BadgeBrush}"
                      IsVisible="{Binding HasCategory}">
                <TextBlock Text="{Binding CategoryName}"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Foreground="White"/>
              </Border>

              <ToggleButton Grid.Column="4"
                            Tag="{Binding}"
                            IsChecked="{Binding IsTaskDone, Mode=OneWay}"
                            Click="OnTaskToggleClicked"
                            IsVisible="{Binding IsTask}"
                            MinWidth="44" Height="22"
                            FontSize="10"
                            Padding="5,1"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Content="{Binding DoneLabel}"/>
            </Grid>
          </DataTemplate>

        </ListBox.DataTemplates>

        <ListBox.Styles>
          <Style Selector="TextBlock.strike">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
          </Style>
        </ListBox.Styles>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
