<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Controls.LessonLogList">
  <UserControl.Resources>
    <ctrl:DateToShortConverter x:Key="DateToShort"/>
    <ctrl:NotEmptyToBoolConverter x:Key="NotEmptyToBool"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- 헤더 -->
    <Border Grid.Row="0" Padding="12,8"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="📘 수업 기록" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
          <TextBlock Name="TxtCount" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Name="BtnAdd"     Click="BtnAdd_Click"     ToolTip.Tip="추가"     Background="Transparent" BorderThickness="0" Padding="8,4" Content="＋"/>
          <Button Name="BtnRefresh" Click="BtnRefresh_Click" ToolTip.Tip="새로고침" Background="Transparent" BorderThickness="0" Padding="8,4" Content="⟳"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 목록 -->
    <ListBox Name="LvLessonLogs" Grid.Row="1"
             SelectionMode="Single"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             Background="Transparent" BorderThickness="0">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="MinHeight" Value="36"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
      </ListBox.Styles>

      <ListBox.ItemTemplate>
        <DataTemplate DataType="models:LessonLog">
          <Grid Margin="8,6" RowDefinitions="Auto,Auto" ColumnDefinitions="72,42,40,*" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding Date, Converter={StaticResource DateToShort}}"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PeriodDisplay}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ClassDisplay}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Topic}"
                       FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                       Text="{Binding SectionName}"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" MaxLines="1"
                       IsVisible="{Binding SectionName, Converter={StaticResource NotEmptyToBool}}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Name="TxtEmpty" Grid.Row="1" Text="수업 기록이 없습니다."
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               IsVisible="False"/>
    <ProgressBar Name="LoadingRing" Grid.Row="1" Width="40" IsIndeterminate="True"
                 IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
  </Grid>
</UserControl>
