<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Controls.LessonLogList">
  <UserControl.Resources>
    <ctrl:DateToShortConverter x:Key="DateToShort"/>
    <ctrl:NotEmptyToBoolConverter x:Key="NotEmptyToBool"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- 헤더 -->
    <Border Grid.Row="0" Padding="12,8"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="📘 수업 기록" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
          <TextBlock Name="TxtCount" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Name="BtnExport"  Click="BtnExport_Click"  ToolTip.Tip="내보내기" Background="Transparent" BorderThickness="0" Padding="8,4" Content="📤"/>
          <Button Name="BtnAdd"     Click="BtnAdd_Click"     ToolTip.Tip="추가"     Background="Transparent" BorderThickness="0" Padding="8,4" Content="＋"/>
          <Button Name="BtnRefresh" Click="BtnRefresh_Click" ToolTip.Tip="새로고침" Background="Transparent" BorderThickness="0" Padding="8,4" Content="⟳"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 필터: 과목 / 강의실 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,6,*" Margin="8,6">
      <ComboBox Name="CboSubject" Grid.Column="0" HorizontalAlignment="Stretch"
                SelectionChanged="OnSubjectChanged"/>
      <ComboBox Name="CboRoom" Grid.Column="2" HorizontalAlignment="Stretch"
                SelectionChanged="OnRoomChanged"/>
    </Grid>

    <!-- 컬럼 헤더 (게시판형) -->
    <Border Grid.Row="2" Padding="8,4"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="64,44,40,54,*" ColumnSpacing="6">
        <TextBlock Grid.Column="0" Text="날짜"  FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <TextBlock Grid.Column="1" Text="교시"  FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <TextBlock Grid.Column="2" Text="학급"  FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <TextBlock Grid.Column="3" Text="과목"  FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <TextBlock Grid.Column="4" Text="주제 / 단원" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      </Grid>
    </Border>

    <!-- 목록 -->
    <ListBox Name="LvLessonLogs" Grid.Row="3"
             SelectionMode="Single"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             Background="Transparent" BorderThickness="0">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="MinHeight" Value="34"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
      </ListBox.Styles>

      <ListBox.ItemTemplate>
        <DataTemplate DataType="models:LessonLog">
          <Grid Margin="8,5" RowDefinitions="Auto,Auto" ColumnDefinitions="64,44,40,54,*" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding Date, Converter={StaticResource DateToShort}}"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PeriodDisplay}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ClassDisplay}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Subject}"
                       FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding Topic}"
                       FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>

            <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                       Text="{Binding SectionName}"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,1,0,0"
                       TextTrimming="CharacterEllipsis" MaxLines="1"
                       IsVisible="{Binding SectionName, Converter={StaticResource NotEmptyToBool}}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Name="TxtEmpty" Grid.Row="3" Text="수업 기록이 없습니다."
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               IsVisible="False"/>
    <ProgressBar Name="LoadingRing" Grid.Row="3" Width="40" IsIndeterminate="True"
                 IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"/>
  </Grid>
</UserControl>
