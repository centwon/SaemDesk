<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaemDesk.Views.Controls.ClassPicker">

  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

    <!-- 학년 -->
    <ComboBox x:Name="CBoxGrade"
              MinWidth="80"
              PlaceholderText="학년"/>

    <!-- 반 -->
    <ComboBox x:Name="CBoxClass"
              MinWidth="76"
              PlaceholderText="반"/>

  </StackPanel>
</UserControl>
