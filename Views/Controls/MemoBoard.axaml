<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Controls.MemoBoard">
  <UserControl.Resources>
    <ctrl:CategoryColorConverter x:Key="CategoryColor"/>
    <ctrl:HtmlToPlainConverter x:Key="HtmlToPlain"/>
  </UserControl.Resources>


  <Border BorderBrush="CornflowerBlue"
          BorderThickness="1"
          CornerRadius="6"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="36,*">

      <!-- 헤더 -->
      <Border Grid.Row="0"
              BorderBrush="CornflowerBlue"
              BorderThickness="0,0,0,1"
              Background="#E6E6FA"
              CornerRadius="6,6,0,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,2">
          <TextBlock Grid.Column="0" Text="📝 메모"
                     FontWeight="Bold" FontSize="14"
                     VerticalAlignment="Center"
                     Foreground="#222"/>
          <ComboBox Grid.Column="1"
                    Name="CategoryFilter"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    SelectedIndex="0"
                    SelectionChanged="OnCategoryChanged">
            <ComboBoxItem Content="전체" Tag=""/>
            <ComboBoxItem Content="수업" Tag="수업"/>
            <ComboBoxItem Content="학급" Tag="학급"/>
            <ComboBoxItem Content="업무" Tag="업무"/>
            <ComboBoxItem Content="개인" Tag="개인"/>
          </ComboBox>
          <Button Grid.Column="3"
                  Content="＋ 추가"
                  Padding="8,2"
                  Background="Transparent"
                  Click="OnAddClick"
                  ToolTip.Tip="새 메모 추가"/>
        </Grid>
      </Border>

      <!-- 목록 -->
      <Grid Grid.Row="1">
        <ScrollViewer Name="ListScroll"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="ItemsView">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:Post">
                <Border BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource ContentSeparatorBrush}"
                        Padding="8,6">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0"
                              Background="{Binding Category, Converter={StaticResource CategoryColor}}"
                              CornerRadius="8"
                              Padding="6,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Category}"
                                   FontSize="10"
                                   Foreground="White"/>
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 FontWeight="SemiBold"
                                 Margin="6,0,0,0"
                                 TextTrimming="CharacterEllipsis"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="{Binding DateTimeDisplay}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        <Button Content="▲" FontSize="9" Padding="3,0" Margin="4,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnMoveUp"
                                ToolTip.Tip="위로 이동"/>
                        <Button Content="▼" FontSize="9" Padding="3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnMoveDown"
                                ToolTip.Tip="아래로 이동"/>
                        <Button Content="🗑" FontSize="10" Padding="3,0" Margin="2,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnDeleteItem"
                                ToolTip.Tip="삭제"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Content, Converter={StaticResource HtmlToPlain}}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               MaxLines="1"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <TextBlock Text="🗒"
                     FontSize="32"
                     Foreground="{DynamicResource SystemBaseMediumLowColor}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="메모가 없습니다"
                     FontSize="13"
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     Margin="0,8,0,0"/>
        </StackPanel>

        <ProgressBar Name="LoadingBar"
                     IsIndeterminate="True"
                     IsVisible="False"
                     VerticalAlignment="Top"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
