<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Controls.MemoBoard">
  <UserControl.Resources>
    <ctrl:CategoryColorConverter  x:Key="CategoryColor"/>
    <ctrl:CategoryBgConverter     x:Key="CategoryBg"/>
    <ctrl:CategoryStripeConverter x:Key="CategoryStripe"/>
    <ctrl:HtmlToPlainConverter    x:Key="HtmlToPlain"/>
  </UserControl.Resources>

  <Border BorderBrush="{DynamicResource CardHeaderBorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="Auto,*">

      <!-- 헤더 -->
      <Border Grid.Row="0"
              Background="{DynamicResource CardHeaderBrush}"
              BorderBrush="{DynamicResource ContentSeparatorBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0"
              MinHeight="36"
              Padding="12,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">

          <!-- 제목 (ShowFilter=False 일 때 표시) -->
          <TextBlock Grid.Column="0"
                     Name="HeaderTitle"
                     Text="📝 메모"
                     FontSize="14" FontWeight="Bold"
                     VerticalAlignment="Center"
                     IsVisible="False"/>

          <!-- 카테고리 필터 칩 -->
          <StackPanel Grid.Column="1"
                      Name="FilterPanel"
                      Orientation="Horizontal"
                      Spacing="4"
                      VerticalAlignment="Center">
            <TextBlock Text="📝" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Button Name="ChipAll"    Content="전체" Tag=""   Click="OnChipClick" Classes="chip active"/>
            <Button Name="ChipLesson" Content="수업" Tag="수업" Click="OnChipClick" Classes="chip"/>
            <Button Name="ChipClass"  Content="학급" Tag="학급" Click="OnChipClick" Classes="chip"/>
            <Button Name="ChipWork"   Content="업무" Tag="업무" Click="OnChipClick" Classes="chip"/>
            <Button Name="ChipSelf"   Content="개인" Tag="개인" Click="OnChipClick" Classes="chip"/>
          </StackPanel>

          <!-- 추가 버튼 -->
          <Button Grid.Column="3"
                  Content="＋ 추가"
                  Height="24" MinHeight="24" FontSize="12"
                  Padding="10,0"
                  VerticalAlignment="Center"
                  Click="OnAddClick"
                  ToolTip.Tip="새 메모 추가"/>
        </Grid>
      </Border>

      <!-- 메모 Masonry (폭에 따라 1~2열 반응형) -->
      <Grid Grid.Row="1">
        <ScrollViewer Name="ListScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <!-- 열은 폭에 따라 코드에서 동적으로 생성 (RebuildColumns) -->
          <Grid Name="ColumnsGrid" Margin="8,8,8,8"/>
        </ScrollViewer>

        <!-- 빈 상태 -->
        <StackPanel Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    Spacing="8">
          <TextBlock Text="🗒" FontSize="36"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
          <TextBlock Text="메모가 없습니다" FontSize="13"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>
        </StackPanel>

        <ProgressBar Name="LoadingBar"
                     IsIndeterminate="True"
                     IsVisible="False"
                     VerticalAlignment="Top"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
