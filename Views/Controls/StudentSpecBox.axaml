<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaemDesk.Views.Controls.StudentSpecBox">
  <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 헤더 -->
      <Border Grid.Row="0" Padding="16,12"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Name="TxtYear" Text="2024" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="학년도" VerticalAlignment="Center"/>
            <TextBlock Name="TxtSemester"      Text="1" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="False"/>
            <TextBlock Name="TxtSemesterLabel" Text="학기"                   VerticalAlignment="Center" IsVisible="False"/>
            <TextBlock Name="TxtType" Text="건강" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
            <TextBlock Name="TxtSubject" Text="" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="학생부 기록" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Name="TxtStudent" Text="" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemAccentColor}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Name="BtnSpellCheck" Click="OnSpellCheckClick" ToolTip.Tip="맞춤법 검사"
                    Background="Transparent" BorderThickness="0" Padding="8,4" Content="🔍"/>
            <Button Name="BtnSave"       Click="OnSaveClick"       ToolTip.Tip="저장"
                    Background="Transparent" BorderThickness="0" Padding="8,4" Content="💾"/>
            <Button Name="BtnDelete"     Click="OnDeleteClick"     ToolTip.Tip="삭제하고 초기화"
                    Background="Transparent" BorderThickness="0" Padding="8,4" Content="🗑"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 내용 -->
      <TextBox Name="TxtContent" Grid.Row="1"
               AcceptsReturn="True" TextWrapping="Wrap"
               Padding="16" BorderThickness="0" Background="Transparent"
               TextChanged="OnTextChanged" LostFocus="OnLostFocus"
               PlaceholderText="특이사항을 입력하세요"/>

      <!-- 바이트 -->
      <Border Grid.Row="2" Padding="16,8"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock Name="TxtByteInfo" Text="0 / 1500 Byte (0자)"
                   FontSize="12" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Border>
    </Grid>
  </Border>
</UserControl>
