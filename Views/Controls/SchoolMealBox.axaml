<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Controls.SchoolMealBox"
             x:DataType="ctrl:SchoolMealBox"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="CalendarDatePicker Calendar">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>
  <Border BorderBrush="{DynamicResource CardHeaderBorderBrush}"
          BorderThickness="1" CornerRadius="8"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          MinHeight="180">
    <Grid RowDefinitions="Auto,*">

      <Border Grid.Row="0" Padding="12,8" Classes="card-header">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="🍱 급식"
                     FontWeight="Bold" VerticalAlignment="Center"
                     FontSize="14" Margin="4,0,12,0"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <Button Name="PreviousDayButton" Content="◀" Click="PreviousDayButton_Click"
                    ToolTip.Tip="이전 날" Width="24" Height="32" Padding="0" FontSize="12"
                    VerticalContentAlignment="Center"/>
            <CalendarDatePicker Name="DatePicker"
                                Width="120" Height="32" FontSize="12"
                                HorizontalAlignment="Center"
                                SelectedDateChanged="DatePicker_DateChanged"/>
            <Button Name="NextDayButton" Content="▶" Click="NextDayButton_Click"
                    ToolTip.Tip="다음 날" Width="24" Height="32" Padding="0" FontSize="12"
                    VerticalContentAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="12,8,12,12" MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="MealsRepeater">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="10"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:SchoolMeal">
              <StackPanel Spacing="4" Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding MealIcon}" FontSize="13"/>
                  <TextBlock Text="{Binding MMEAL_SC_NM}" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource SystemAccentColor}"/>
                </StackPanel>
                <TextBlock Text="{Binding MenuText}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="22,0,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
