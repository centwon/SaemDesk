<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaemDesk.Views.Controls.YearSemesterPicker">

  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

    <!-- 학년도 -->
    <ComboBox x:Name="CBoxYear"
              MinWidth="110"
              PlaceholderText="학년도"/>

    <!-- 학기 (ShowSemester=true 일 때만 표시) -->
    <ComboBox x:Name="CBoxSemester"
              MinWidth="80"
              PlaceholderText="학기"/>

  </StackPanel>
</UserControl>
