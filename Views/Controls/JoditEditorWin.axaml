<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:SaemDesk.Views.Controls"
        x:Class="SaemDesk.Views.Controls.JoditEditorWin"
        Title="편집기"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">

    <!-- JoditEditor -->
    <ctrl:JoditEditor Name="joditEditor" Grid.Row="0"/>

    <!-- 하단 버튼 -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="16,12">
      <Button Name="btnOk"
              Content="확인"
              Classes="accent"
              MinWidth="80"
              Click="BtnOk_Click"/>
      <Button Name="btnCancel"
              Content="취소"
              MinWidth="80"
              Click="BtnCancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
