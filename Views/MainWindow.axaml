<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaemDesk.ViewModels"
        x:Class="SaemDesk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="샘Desk"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ══════════════════════════════════════
         좌측 네비게이션 패널
         ══════════════════════════════════════ -->
    <Border Grid.Column="0"
            Background="{DynamicResource NavBackgroundBrush}"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource ContentSeparatorBrush}">
      <DockPanel>

        <!-- 앱 헤더 -->
        <Border DockPanel.Dock="Top"
                Padding="16,20,16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ContentSeparatorBrush}">
          <StackPanel Spacing="2">
            <TextBlock Text="샘Desk"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BrandPrimaryBrush}" />
            <TextBlock Text="학급 관리 시스템"
                       FontSize="11"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
          </StackPanel>
        </Border>

        <!-- 하단 버튼 (설정) -->
        <ListBox DockPanel.Dock="Bottom"
                 ItemsSource="{x:Static vm:MainWindowViewModel.BottomNavItems}"
                 SelectedItem="{Binding SelectedBottomNavItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,4">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Grid ColumnDefinitions="32,*" Height="38">
                <TextBlock Grid.Column="0"
                           Text="{Binding Icon}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontSize="13"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,2" />
              <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}" />
            </Style>
          </ListBox.Styles>
        </ListBox>

        <!-- 버전 텍스트 -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="v0.1.0-alpha"
                   FontSize="10"
                   Margin="16,0,16,4"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}" />

        <!-- 상단 네비게이션 (트리) -->
        <TreeView ItemsSource="{x:Static vm:MainWindowViewModel.AllNavItems}"
                  SelectedItem="{Binding SelectedNavItem}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,8">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:NavItem"
                              ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="28,*" Height="34">
                <TextBlock Grid.Column="0"
                           Text="{Binding Icon}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontSize="13"
                           VerticalAlignment="Center" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="Padding" Value="2,2" />
              <Setter Property="CornerRadius" Value="6" />
              <Setter Property="IsExpanded" Value="True" />
            </Style>
            <Style Selector="TreeViewItem:pointerover /template/ Border#PART_Header">
              <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
            </Style>
            <Style Selector="TreeViewItem:selected /template/ Border#PART_Header">
              <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}" />
            </Style>
          </TreeView.Styles>
        </TreeView>

      </DockPanel>
    </Border>

    <!-- 구분선 -->
    <GridSplitter Grid.Column="1"
                  Width="1"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"
                  Background="{DynamicResource ContentSeparatorBrush}" />

    <!-- ══════════════════════════════════════
         콘텐츠 영역
         ══════════════════════════════════════ -->
    <TransitioningContentControl Grid.Column="2"
                                 Content="{Binding CurrentPage}"
                                 Background="{DynamicResource ContentBackgroundBrush}" />

  </Grid>
</Window>
