<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaemDesk.ViewModels"
        x:Class="SaemDesk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="샘Desk"
        Width="1280" Height="780"
        MinWidth="960" MinHeight="600">

  <Grid RowDefinitions="Auto,*">

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 상단 네비게이션 바 (NewSchool PaneDisplayMode=Top) -->
    <!-- ══════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            MinHeight="36"
            Background="{DynamicResource NavBackgroundBrush}"
            BorderBrush="{DynamicResource ContentSeparatorBrush}"
            BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True" MinHeight="36">

        <!-- ── 앱 로고/제목 ─────────────────────────── -->
        <Border DockPanel.Dock="Left"
                Padding="16,0"
                MinHeight="36"
                BorderBrush="{DynamicResource ContentSeparatorBrush}"
                BorderThickness="0,0,1,0">
          <TextBlock Text="샘Desk"
                     FontSize="18" FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource BrandPrimaryBrush}"/>
        </Border>

        <!-- ── 우측: 버전 표시 ───────────────────────── -->
        <TextBlock DockPanel.Dock="Right"
                   Text="v1.0.0"
                   FontSize="10"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"/>

        <!-- ── 수평 메뉴 ─────────────────────────────── -->
        <Menu Background="Transparent"
              Margin="4,0"
              VerticalAlignment="Stretch">
          <Menu.Styles>
            <Style Selector="MenuItem">
              <Setter Property="Padding"   Value="12,0"/>
              <Setter Property="MinHeight" Value="36"/>
              <Setter Property="FontSize"  Value="13"/>
            </Style>
            <Style Selector="MenuItem.selected">
              <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}"/>
            </Style>
          </Menu.Styles>

          <!-- 홈 -->
          <MenuItem Header="🏠 홈" Click="OnMenuClick" Tag="Home"/>

          <!-- 달력 -->
          <MenuItem Header="📅 달력" Click="OnMenuClick" Tag="Calendar"/>

          <!-- 학급 -->
          <MenuItem Header="👥 학급">
            <MenuItem Header="📓 학급 일지"        Click="OnMenuClick" Tag="ClassDiary"/>
            <MenuItem Header="👤 학생 정보"        Click="OnMenuClick" Tag="StudentInfo"/>
            <MenuItem Header="✏ 학생 기록"        Click="OnMenuClick" Tag="StudentLog"/>
            <MenuItem Header="📋 학생부 관리"      Click="OnMenuClick" Tag="StudentSpec"/>
            <MenuItem Header="🪑 자리 배정"        Click="OnMenuClick" Tag="Seats"/>
            <MenuItem Header="📌 학급 게시판"      Click="OnMenuClick" Tag="ClassBoard"/>
            <MenuItem Header="🖨 학생정보 출력"    Click="OnMenuClick" Tag="StudentInfoExport"/>
            <MenuItem Header="📤 통합 내보내기"    Click="OnMenuClick" Tag="UnifiedExport"/>
            <MenuItem Header="🗓 학급 시간표 관리" Click="OnMenuClick" Tag="Timetable_ClassManagement"/>
          </MenuItem>

          <!-- 수업 -->
          <MenuItem Header="📚 수업">
            <MenuItem Header="🏠 수업홈"           Click="OnMenuClick" Tag="LessonHome"/>
            <MenuItem Header="✏ 누가 기록"        Click="OnMenuClick" Tag="LessonActivity"/>
            <MenuItem Header="📋 교과 세부능력 및 특기 사항" Click="OnMenuClick" Tag="LessonSpec"/>
            <MenuItem Header="🗓 수업 시간표"      Click="OnMenuClick" Tag="Timetable_Teacher"/>
            <MenuItem Header="📌 수업 게시판"      Click="OnMenuClick" Tag="LessonBoard"/>
            <MenuItem Header="📚 수업 관리"        Click="OnMenuClick" Tag="CourseManagement"/>
            <MenuItem Header="🎭 동아리 활동"      Click="OnMenuClick" Tag="ClubActivity"/>
          </MenuItem>

          <!-- 업무 -->
          <MenuItem Header="💼 업무">
            <MenuItem Header="💼 업무 관리"    Click="OnMenuClick" Tag="SchoolWork"/>
            <MenuItem Header="📌 업무 게시판"  Click="OnMenuClick" Tag="WorkBoard"/>
          </MenuItem>

          <!-- 아카이브 -->
          <MenuItem Header="🗃 아카이브" Click="OnMenuClick" Tag="Archive"/>

          <!-- 설정 -->
          <MenuItem Header="⚙ 설정">
            <MenuItem Header="🏫 학교 설정"     Click="OnMenuClick" Tag="Settings_School"/>
            <MenuItem Header="🗓 학사일정 관리" Click="OnMenuClick" Tag="Settings_SchoolSchedule"/>
            <MenuItem Header="👤 학생 관리"     Click="OnMenuClick" Tag="Settings_Student"/>
            <MenuItem Header="⚙ 앱 설정"       Click="OnMenuClick" Tag="Settings_App"/>
            <MenuItem Header="❓ 도움말"        Click="OnMenuClick" Tag="Help"/>
            <MenuItem Header="🔄 업데이트 확인" Click="OnMenuClick" Tag="CheckUpdate"/>
          </MenuItem>

        </Menu>
      </DockPanel>
    </Border>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 콘텐츠 영역                                         -->
    <!-- ══════════════════════════════════════════════════ -->
    <TransitioningContentControl Grid.Row="1" Padding="4"
                                 Content="{Binding CurrentPage}"
                                 Background="{DynamicResource ContentBackgroundBrush}"/>

  </Grid>
</Window>
