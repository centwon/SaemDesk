<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.CourseManagementPage"
             x:DataType="vm:CourseManagementPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 헤더 -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,4">
      <TextBlock Text="수업 관리" Classes="page-title"/>
      <TextBlock Text="학년도/학기별 학교 전체 수업(과목·선택과목·동아리) CRUD"
                 Classes="page-subtitle"/>
    </StackPanel>

    <!-- 필터 / 검색 / 툴바 -->
    <Grid Grid.Row="1" Margin="0,8,0,8"
          ColumnDefinitions="Auto,Auto,Auto">

      <!-- 학년도 + 학기 -->
      <ctrl:YearSemesterPicker Grid.Column="0"
                               x:Name="YearSemPicker"
                               ShowYear="True" ShowSemester="True"
                               Margin="0,0,12,0"
                               YearSemesterChanged="OnYearSemesterChanged"/>

      <!-- 액션 버튼 -->
      <Button Grid.Column="1" Content="추가"
              Classes="accent btn-md"
              Command="{Binding AddCourseCommand}"
              HotKey="Ctrl+N"
              Margin="0,0,6,0"/>
      <Button Grid.Column="2" Content="새로고침" Classes="btn-md"
              Command="{Binding QueryCommand}"/>
    </Grid>

    <!-- 본문: 수업 카드 목록 (NewSchool 동등) -->
    <Grid Grid.Row="2" Margin="0,0,0,8">

      <!-- 빈 상태 -->
      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="📖" FontSize="48" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Text="등록된 수업이 없습니다"
                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="[수업 추가] 버튼으로 새 수업을 등록하세요"
                   FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
      </StackPanel>

      <!-- 카드 목록 -->
      <ScrollViewer IsVisible="{Binding HasCourses}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Courses}" Margin="0,4,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:Course">
              <Border Classes="card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">

                  <!-- 좌: 수업 정보 -->
                  <StackPanel Grid.Column="0" Spacing="8">

                    <!-- 과목명 + 유형 배지 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Subject}"
                                 FontSize="16" FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                      <Border Background="{DynamicResource SystemAccentColor}"
                              CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding TypeDisplay}"
                                   FontSize="11" Foreground="White"/>
                      </Border>
                    </StackPanel>

                    <!-- 학년 / 시수 -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <TextBlock FontSize="13">
                        <Run Text="학년: "/>
                        <Run Text="{Binding Grade}" FontWeight="SemiBold"/>
                        <Run Text="학년"/>
                      </TextBlock>
                      <TextBlock FontSize="13">
                        <Run Text="시수: "/>
                        <Run Text="{Binding Unit}" FontWeight="SemiBold"/>
                        <Run Text="시간"/>
                      </TextBlock>
                    </StackPanel>

                    <!-- 강의실 배지 -->
                    <Border Background="{DynamicResource SystemListLowColor}"
                            CornerRadius="4" Padding="8,3"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding Rooms, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock FontSize="12">
                        <Run Text="📍 "/>
                        <Run Text="{Binding RoomListDisplay}" FontWeight="SemiBold"/>
                      </TextBlock>
                    </Border>

                    <!-- 비고 -->
                    <TextBlock Text="{Binding Remark}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               IsVisible="{Binding Remark, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- 우: 액션 버튼 (NewSchool 동등) -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal"
                              Spacing="6" VerticalAlignment="Center">
                    <Button Content="수강 학생"
                            Classes="btn-sm"
                            ToolTip.Tip="수강 학생 관리"
                            Command="{Binding $parent[UserControl].((vm:CourseManagementPageVM)DataContext).EnrollStudentsCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Content="시간표 배치"
                            Classes="btn-sm"
                            Command="{Binding $parent[UserControl].((vm:CourseManagementPageVM)DataContext).ScheduleCourseCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Content="✏ 수정"
                            Classes="accent btn-sm"
                            Command="{Binding $parent[UserControl].((vm:CourseManagementPageVM)DataContext).EditItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Content="🗑"
                            Classes="btn-sm"
                            ToolTip.Tip="삭제"
                            Command="{Binding $parent[UserControl].((vm:CourseManagementPageVM)DataContext).DeleteItemCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 로딩 오버레이 -->
      <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource LoadingOverlayBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <ProgressBar Width="160" IsIndeterminate="True"/>
          <TextBlock Text="조회 중…" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 상태바 -->
    <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                 FontSize="11"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding ErrorText}"
                 FontSize="11" Foreground="{DynamicResource ErrorForegroundBrush}"
                 VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>
