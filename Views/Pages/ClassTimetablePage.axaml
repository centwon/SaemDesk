<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.ClassTimetablePage"
             x:DataType="vm:ClassTimetablePageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,12,*">

    <!-- ── 헤더 (필터 + 모드 토글) ─────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
      <TextBlock Grid.Column="0" Text="학급 시간표" Classes="page-title"
                 VerticalAlignment="Center" Margin="0,0,16,0"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center">
        <ctrl:YearSemesterPicker x:Name="YearSemPicker"
                                 ShowYear="True" ShowSemester="True"/>
        <ctrl:ClassPicker x:Name="ClassFilter"
                          IncludeAllClass="False"/>
        <ProgressBar Width="60" Height="4"
                     IsIndeterminate="True"
                     IsVisible="{CompiledBinding IsLoading}"
                     VerticalAlignment="Center"/>
      </StackPanel>

      <ToggleButton Grid.Column="3"
                    Content="✏ 편집 모드"
                    IsChecked="{CompiledBinding IsEditMode, Mode=TwoWay}"
                    VerticalAlignment="Center"/>
    </Grid>

    <!-- ── 본문 ───────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="*,12,220">

      <!-- 시간표 그리드 -->
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource CardHeaderBorderBrush}"
              BorderThickness="1" CornerRadius="8" ClipToBounds="True"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid x:Name="TimetableGrid" ColumnSpacing="0" RowSpacing="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- 좌상단 -->
          <Border Grid.Row="0" Grid.Column="0"
                  Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}"
                  BorderThickness="0,0,1,1"/>

          <!-- 요일 헤더 -->
          <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="월" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="화" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="수" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="목" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="0" Grid.Column="5" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="금" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
          </Border>

          <!-- 교시 라벨 -->
          <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="4" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="5" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="6" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,1">
            <TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <Border Grid.Row="7" Grid.Column="0" Background="{DynamicResource CardHeaderBrush}"
                  BorderBrush="{DynamicResource ContentSeparatorBrush}" BorderThickness="0,0,1,0">
            <TextBlock Text="7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          </Border>

          <!-- 내용 셀은 코드비하인드에서 생성 -->
        </Grid>
      </Border>

      <!-- 편집 패널 -->
      <Border Grid.Column="2"
              IsVisible="{CompiledBinding IsEditing}"
              Classes="card" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="시간표 편집" FontWeight="Bold" FontSize="14"/>
          <TextBlock Text="{CompiledBinding EditCellInfo}"
                     Classes="page-subtitle" Margin="0,0,0,4"/>

          <StackPanel Spacing="4">
            <TextBlock Text="과목" FontSize="12"/>
            <TextBox Text="{CompiledBinding EditSubject, Mode=TwoWay}" PlaceholderText="과목명"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="교사" FontSize="12"/>
            <TextBox Text="{CompiledBinding EditTeacher, Mode=TwoWay}" PlaceholderText="교사명"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="저장" Command="{CompiledBinding SaveEditCommand}"/>
            <Button Content="삭제" Command="{CompiledBinding DeleteEditCommand}"
                    IsVisible="{CompiledBinding CanDelete}"/>
            <Button Content="취소" Command="{CompiledBinding CancelEditCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
