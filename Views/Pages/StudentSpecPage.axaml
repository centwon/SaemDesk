<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.StudentSpecPage"
             x:DataType="vm:StudentSpecPageVM"
             Classes="page">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── 필터 및 버튼 영역 ─────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 필터 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <ctrl:YearSemesterPicker x:Name="YearSemPicker"
                                   ShowYear="True"
                                   ShowSemester="False"/>
          <ctrl:ClassPicker x:Name="ClassFilter" IncludeAllClass="False"/>
          <ComboBox Name="CBoxCategory"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    MinWidth="140"
                    VerticalAlignment="Center"
                    SelectionChanged="OnCategoryChanged"/>
        </StackPanel>

        <!-- 오른쪽: 버튼 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">

          <!-- 그룹1: 개별 편집 -->
          <Button Name="BtnSave"   Click="OnSaveClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="저장" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Name="BtnDelete" Click="OnDeleteClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="🗑" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="삭제" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- 세로 구분선 -->
          <Border Width="1" Margin="4,4" VerticalAlignment="Stretch"
                  Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

          <!-- 그룹2: 일괄 작업 -->
          <Button Name="BtnBatchInput"  ToolTip.Tip="일괄 입력" Click="OnBatchInputClick">
            <TextBlock Text="📝" FontSize="20" VerticalAlignment="Center"/>
          </Button>
          <Button Name="BtnBatchExport" ToolTip.Tip="일괄 출력" Click="OnBatchExportClick">
            <TextBlock Text="📤" FontSize="20" VerticalAlignment="Center"/>
          </Button>

          <!-- 세로 구분선 -->
          <Border Width="1" Margin="4,4" VerticalAlignment="Stretch"
                  Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

          <!-- 글꼴 크기 -->
          <Button Name="BtnFontResize" ToolTip.Tip="글자 크기 변경" Padding="8,6">
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Grid Width="180" Height="140" Margin="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Stretch" Spacing="4" Width="36">
                    <TextBlock x:Name="TbMax" Text="30" FontSize="9" HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,4,4,0"/>
                    <TextBlock x:Name="TbSize" Text="13" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                    <TextBlock x:Name="TbMin" Text="6" FontSize="9" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Margin="0,0,4,4"/>
                  </StackPanel>
                  <Slider x:Name="SldFontSize"
                          Grid.Column="1"
                          Orientation="Vertical"
                          Minimum="6" Maximum="30" Value="13"
                          TickFrequency="2" IsSnapToTickEnabled="True"
                          VerticalAlignment="Stretch"
                          ValueChanged="SldFontSize_ValueChanged"/>
                </Grid>
              </Flyout>
            </Button.Flyout>
            <TextBlock Text="🔠" FontSize="20" VerticalAlignment="Center"/>
          </Button>

        </StackPanel>
      </Grid>
    </Border>

    <!-- ── 목록 ──────────────────────────────────────────── -->
    <ctrl:SpecListViewer Name="SpecListViewer" Grid.Row="2" Margin="12,0,12,12"/>
  </Grid>
</UserControl>
