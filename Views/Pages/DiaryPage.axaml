<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.DiaryPage"
             x:DataType="vm:DiaryPageVM"
             Classes="page"
             Padding="0">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 상단 헤더 -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Padding="4,3"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="4,4">
          <ctrl:YearSemesterPicker x:Name="YearSemPicker"
                                   ShowYear="False"
                                   ShowSemester="False"/>
          <ctrl:ClassPicker x:Name="ClassFilter"
                            IncludeAllClass="False"/>
          <Button Content="조회" Classes="accent" Padding="16,4"
                  VerticalAlignment="Bottom" Click="BtnLoad_Click"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="◀" Padding="6,4"
                  Background="Transparent" BorderThickness="0"
                  Click="BtnDatePrev_Click"/>
          <CalendarDatePicker Grid.Column="1" Name="DatePicker"
                              MinWidth="160" Margin="4,0"
                              SelectedDateChanged="DatePicker_DateChanged"/>
          <Button Grid.Column="2" Content="▶" Padding="6,4"
                  Background="Transparent" BorderThickness="0"
                  Click="BtnDateNext_Click"/>
        </Grid>

        <Button Grid.Column="3" Content="📋 목록 보기"
                Classes="accent"
                Padding="12,4" VerticalAlignment="Center" Margin="4,4,16,4"
                Click="BtnViewDiaryList_Click"/>
      </Grid>
    </Border>

    <!-- 학생 목록 (좌측) -->
    <ctrl:ListStudent Name="StudentList"
                      Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                      Margin="4,4,4,4"/>

    <!-- 학급일지 입력 (우측 상단) — 알림장 펼침 시 일지 영역 내부에서 스크롤 -->
    <ScrollViewer Grid.Row="1" Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="420">
      <ctrl:ClassDiaryBox Name="DiaryBox" Margin="4,4,4,4"/>
    </ScrollViewer>

    <!-- 당일 학생 기록 (우측 하단) -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="4,0,4,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 당일 기록 헤더 -->
      <Border Grid.Row="0" Padding="8,4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Name="TxtDailyLogTitle" Text="당일 학생 기록"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Name="TxtDailyLogCount" Text=""
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <Button Name="BtnAddDailyLog" Content="＋ 추가"
                    Classes="accent" Padding="10,4" Click="BtnAddDailyLog_Click"/>
            <Button Name="BtnRefreshLogs" Content="⟳"
                    Padding="6,4" Background="Transparent" BorderThickness="0"
                    Click="BtnRefreshLogs_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <ctrl:LogListViewer Name="DailyLogList" Grid.Row="1"/>
    </Grid>
  </Grid>
</UserControl>
