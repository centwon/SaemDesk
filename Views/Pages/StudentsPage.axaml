<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:vms="using:SaemDesk.ViewModels"
             x:Class="SaemDesk.Views.Pages.StudentsPage"
             x:DataType="vm:StudentsPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ── 헤더 ──────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Margin="20,20,20,0" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="◉"
                   FontSize="22"
                   Foreground="{StaticResource BrandPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ClassHeaderText}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusText}"
                   FontSize="13"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding SchoolYearText}"
                 FontSize="13"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- ── 툴바 ─────────────────────────────────────────── -->
    <Grid Grid.Row="1" Margin="20,12,20,0" ColumnDefinitions="*,Auto">

      <!-- 왼쪽: 검색 -->
      <TextBox Grid.Column="0"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="이름 또는 번호로 검색…"/>

      <!-- 오른쪽: 액션 버튼들 -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="8,0,0,0">

        <!-- 학생 추가 -->
        <Button Content="학생 추가"
                Command="{Binding AddStudentCommand}"
                Classes="accent"
                Padding="12,6"/>

        <!-- 상세 (선택 시만 활성) -->
        <Button Content="상세"
                Command="{Binding ViewSelectedStudentDetailCommand}"
                IsEnabled="{Binding HasSelection}"
                Padding="12,6"/>

        <!-- 수정 (선택 시만 활성) -->
        <Button Content="수정"
                Command="{Binding EditSelectedStudentCommand}"
                IsEnabled="{Binding HasSelection}"
                Padding="12,6"/>

        <!-- 삭제 (선택 시만 활성) -->
        <Button Content="삭제"
                Command="{Binding DeleteSelectedStudentCommand}"
                IsEnabled="{Binding HasSelection}"
                Padding="12,6"/>

        <!-- 내보내기 -->
        <Button Content="내보내기"
                Command="{Binding ExportClassCommand}"
                Padding="12,6"/>

        <!-- 새로고침 -->
        <Button Content="새로고침"
                Command="{Binding LoadStudentsCommand}"
                Padding="12,6"/>

      </StackPanel>
    </Grid>

    <!-- ── 본문 ──────────────────────────────────────────── -->
    <Panel Grid.Row="2">

      <!-- 로딩 중 -->
      <ProgressBar IsVisible="{Binding IsLoading}"
                   IsIndeterminate="True"
                   VerticalAlignment="Top"
                   Margin="20,8,20,0"/>

      <!-- 오류 메시지 -->
      <TextBlock IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding ErrorText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemErrorTextColor}"
                 FontSize="13"/>

      <!-- 빈 상태 -->
      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="등록된 학생이 없습니다."
                   FontSize="15"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Text="'학생 추가' 버튼으로 학생을 등록하세요."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
      </StackPanel>

      <!-- 학생 목록 (ListBox — 선택 지원) -->
      <ListBox IsVisible="{Binding HasStudents}"
               ItemsSource="{Binding Students}"
               SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               Margin="20,4,20,20">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vms:StudentListItemViewModel">
            <Grid ColumnDefinitions="40,*,Auto" Margin="0,3">

              <!-- 번호 원형 배지 -->
              <Border Grid.Column="0"
                      Width="32" Height="32"
                      CornerRadius="16"
                      Background="{StaticResource BrandPrimaryBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding Number}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>

              <!-- 이름 + 성별 -->
              <StackPanel Grid.Column="1"
                          Margin="12,0,8,0"
                          VerticalAlignment="Center"
                          Spacing="2">
                <TextBlock Text="{Binding Name}"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Sex}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
              </StackPanel>

              <!-- 재학 상태 배지 -->
              <Border Grid.Column="2"
                      VerticalAlignment="Center"
                      Padding="8,3"
                      CornerRadius="4"
                      Background="{DynamicResource SystemListLowColor}">
                <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
              </Border>

            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>

        <!-- ListBox 항목 스타일 — card 느낌으로 -->
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="0 2 8 0 #20000000">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
              </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border">
              <Setter Property="Background" Value="{DynamicResource SystemListLowColor}"/>
              <Setter Property="BoxShadow" Value="0 2 8 0 #40000000"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border">
              <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}"/>
            </Style>
          </ControlTheme>
        </ListBox.ItemContainerTheme>

      </ListBox>

    </Panel>
  </Grid>
</UserControl>
