<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.StudentsPage"
             x:DataType="vm:StudentsPageVM"
             Classes="page">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 필터 + 버튼 카드 -->
      <RowDefinition Height="*"/>     <!-- 테이블 -->
    </Grid.RowDefinitions>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 필터 + 버튼 카드                                    -->
    <!-- ══════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1" CornerRadius="8"
            Margin="16,16,16,0" Padding="16,12">
      <StackPanel Spacing="10">

        <!-- 1행: 필터 -->
        <StackPanel Orientation="Horizontal" Spacing="8">

          <!-- 학년도/학년/반 공통 필터 -->
          <ctrl:ClassFilterBar x:Name="FilterBar"/>

          <!-- 조회 버튼 -->
          <Button Content="조회"
                  Classes="accent"
                  Padding="20,6"
                  VerticalAlignment="Bottom"
                  Click="OnQueryClick"/>
        </StackPanel>

        <!-- 2행: 액션 버튼 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="BtnSave"   Content="저장"   Padding="20,6" Click="OnSaveClick"/>
          <Button Name="BtnDelete" Content="삭제"   Padding="20,6" Click="OnDeleteClick"/>
          <Button Name="BtnAdd"    Content="학생 추가" Padding="20,6" Click="OnAddStudentClick"
                  Classes="accent"/>

          <TextBlock Name="TxtStudentCount"
                     Text="{Binding StatusText}"
                     VerticalAlignment="Center"
                     Margin="16,0,0,0"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 테이블 영역                                         -->
    <!-- ══════════════════════════════════════════════════ -->
    <Border Grid.Row="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1" CornerRadius="8"
            Margin="16,10,16,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- 고정 헤더 -->
          <RowDefinition Height="*"/>     <!-- 데이터 행 -->
        </Grid.RowDefinitions>

        <!-- ── 고정 헤더 ────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
          <Grid ColumnDefinitions="44,148,80,60,60,60,*,80,*">
            <CheckBox Name="ChkSelectAll"
                      Grid.Column="0"
                      Click="OnSelectAllClick"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="학생ID"  FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="2" Text="학년도"  FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="3" Text="학년"    FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="4" Text="반"      FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="5" Text="번호"    FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="6" Text="이름"    FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="7" Text="상태"    FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
            <TextBlock Grid.Column="8" Text="비고"    FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
          </Grid>
        </Border>

        <!-- ── 빈 상태 ──────────────────────────────────── -->
        <StackPanel Grid.Row="1"
                    Name="EmptyState"
                    IsVisible="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="👥" FontSize="48"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
          <TextBlock Text="조회된 학생이 없습니다."
                     FontSize="15" HorizontalAlignment="Center"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
          <TextBlock Text="학년도·학년·반을 선택하고 조회 버튼을 눌러주세요."
                     FontSize="12" HorizontalAlignment="Center"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
        </StackPanel>

        <!-- ── 데이터 행 (ListBox 기반 인라인 편집) ──────── -->
        <ListBox Grid.Row="1"
                 Name="StudentList"
                 IsVisible="False"
                 ItemsSource="{Binding Students}"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Multiple">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin"  Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <ControlTemplate>
                  <Border Background="Transparent"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                          BorderThickness="0,0,0,1">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch"/>
                  </Border>
                </ControlTemplate>
              </Setter>
            </ControlTheme>
          </ListBox.ItemContainerTheme>

          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StudentManagementViewModel">
              <Grid ColumnDefinitions="44,148,80,60,60,60,*,80,*"
                    Margin="12,6" Background="Transparent">

                <!-- 체크박스 -->
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Click="OnStudentCheckBoxClick"/>

                <!-- 학생ID (읽기전용) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StudentID}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- 학년도 (편집가능) -->
                <TextBox Grid.Column="2"
                         Text="{Binding Year, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Padding="2,1"
                         FontSize="13"
                         TextChanged="OnStudentDataChanged"/>

                <!-- 학년 -->
                <TextBox Grid.Column="3"
                         Text="{Binding Grade, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Padding="2,1"
                         FontSize="13"
                         TextChanged="OnStudentDataChanged"/>

                <!-- 반 -->
                <TextBox Grid.Column="4"
                         Text="{Binding Class, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Padding="2,1"
                         FontSize="13"
                         TextChanged="OnStudentDataChanged"/>

                <!-- 번호 -->
                <TextBox Grid.Column="5"
                         Text="{Binding Number, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Padding="2,1"
                         FontSize="13"
                         TextChanged="OnStudentDataChanged"/>

                <!-- 이름 -->
                <TextBox Grid.Column="6"
                         Text="{Binding Name, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Padding="2,1"
                         FontSize="13"
                         TextChanged="OnStudentDataChanged"/>

                <!-- 상태 (읽기전용) -->
                <TextBlock Grid.Column="7"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- 비고 -->
                <TextBox Grid.Column="8"
                         Text="{Binding Memo, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         Padding="2,1"
                         FontSize="13"
                         PlaceholderText="비고"
                         TextChanged="OnStudentDataChanged"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </Grid>
    </Border>
  </Grid>
</UserControl>
