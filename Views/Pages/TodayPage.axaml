<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             xmlns:board="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.TodayPage"
             x:DataType="vm:TodayPageVM"
             Classes="page">

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="200"/>
      </Grid.ColumnDefinitions>

      <!-- 좌측 패널 -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="10">

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource CardHeaderBorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <Grid RowDefinitions="34,Auto">
            <Border Grid.Row="0" Classes="card-header">
              <TextBlock Text="📚 수업 시간표" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
            </Border>
            <Border Grid.Row="1" Padding="0">
              <Viewbox Stretch="Uniform" MaxHeight="280">
                <ctrl:TimetableControl Name="LecTimeTable" Width="260" Height="260"/>
              </Viewbox>
            </Border>
          </Grid>
        </Border>

        <ctrl:SchoolScheduleListControl Name="ScheduleList" Grid.Row="1"/>
        <ctrl:SchoolMealBox Name="MealBox" Grid.Row="2"/>
      </Grid>

      <!-- 우측 패널 -->
      <Grid Grid.Column="2" RowDefinitions="270,16,*">
        <ctrl:KAgendaControl Name="AgendaList" Grid.Row="0"/>
        <ctrl:MemoBoard Name="MemoBoard" Grid.Row="2"
                         FixedSubject="메모"
                         ShowFilter="False"/>
      </Grid>
    </Grid>
</UserControl>
