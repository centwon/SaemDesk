<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.ProgressMatrixPage"
             x:DataType="vm:ProgressMatrixPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,16">

    <!-- 헤더 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,10">
      <TextBlock Text="진도 관리" FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding Courses}"
                SelectedItem="{Binding SelectedCourse, Mode=TwoWay}"
                MinWidth="280"
                PlaceholderText="수업 선택">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="models:Course">
            <TextBlock Text="{Binding DisplayName}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="새로고침" Padding="12,6" Command="{Binding RefreshCommand}"/>
      <Button Content="격차 분석" Padding="12,6" Command="{Binding AnalyzeGapCommand}"/>
      <Button Content="🔄 일정 동기화" Padding="12,6"
              Command="{Binding SyncFromSchedulesCommand}"
              ToolTip.Tip="완료 표시된 차시별 시간표 → 진도 자동 반영"/>
      <Button Content="📊 Excel" Padding="12,6" Command="{Binding ExportExcelCommand}"/>
      <ProgressBar Width="100" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- 범례 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
      <Border Background="#4CAF50" Width="14" Height="14" CornerRadius="3"/>
      <TextBlock Text="완료" FontSize="11" VerticalAlignment="Center"/>
      <Border Background="#2196F3" Width="14" Height="14" CornerRadius="3"/>
      <TextBlock Text="보강" FontSize="11" VerticalAlignment="Center"/>
      <Border Background="#9C27B0" Width="14" Height="14" CornerRadius="3"/>
      <TextBlock Text="병합" FontSize="11" VerticalAlignment="Center"/>
      <Border Background="#FF9800" Width="14" Height="14" CornerRadius="3"/>
      <TextBlock Text="건너뜀" FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- 매트릭스 -->
    <Border Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource ContentSeparatorBrush}"
            CornerRadius="4">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 헤더: 강의실 컬럼 -->
          <StackPanel Orientation="Horizontal"
                      Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Border Width="320" Height="34" Padding="10,6">
              <TextBlock Text="단원" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <ItemsControl ItemsSource="{Binding Rooms}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="56" Height="34"
                          BorderThickness="1,0,0,0"
                          BorderBrush="{DynamicResource ContentSeparatorBrush}">
                    <TextBlock Text="{Binding}" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 행 -->
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:MatrixRow">
                <StackPanel Orientation="Horizontal"
                            Height="36">
                  <Border Width="320" Padding="10,6"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource ContentSeparatorBrush}">
                    <TextBlock Text="{Binding SectionName}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:MatrixCell">
                        <Button Width="56" Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="1,0,0,1"
                                BorderBrush="{DynamicResource ContentSeparatorBrush}"
                                Command="{Binding $parent[ItemsControl].((vm:ProgressMatrixPageVM)DataContext).ToggleCellCommand}"
                                CommandParameter="{Binding}">
                          <Border Background="{Binding BgColor}"
                                  CornerRadius="4"
                                  Margin="6">
                            <TextBlock Text="{Binding Glyph}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 통계 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,*,*,Auto" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="전체 단원:" Opacity="0.6"/>
        <TextBlock Text="{Binding TotalSections}" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <TextBlock Text="선두 분반:" Opacity="0.6"/>
        <TextBlock Text="{Binding LeadingRoom}" FontWeight="SemiBold" Foreground="#4CAF50"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <TextBlock Text="최대 격차:" Opacity="0.6"/>
        <TextBlock Text="{Binding MaxGap}" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock Grid.Column="3"
                 Text="{Binding ErrorText}"
                 IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#D9372A"/>
    </Grid>
  </Grid>
</UserControl>
