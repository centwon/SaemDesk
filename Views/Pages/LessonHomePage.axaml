<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="clr-namespace:SaemDesk.Views.Controls"
             xmlns:board="clr-namespace:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.LessonHomePage"
             x:DataType="vm:LessonHomePageVM"
             Classes="page">

  <UserControl.Styles>
    <Style Selector="Border.lesson-row-current">
      <Setter Property="Background" Value="#154285F4"/>
    </Style>
    <Style Selector="Button.status-completed">
      <Setter Property="Background"      Value="#150F9D58"/>
      <Setter Property="Foreground"      Value="#0F9D58"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.status-current">
      <Setter Property="Background"      Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.status-pending">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="{DynamicResource SystemBaseMediumColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── 페이지 헤더 ────────────────────────────────────── -->
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="10"
                Margin="4,0,0,8">
      <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding PageHeaderDate}"
                 FontSize="16" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ── 메인 2-column ──────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ══════════════════════════════════════════════════ -->
      <!-- 좌측: 시간표 카드 + 할일                           -->
      <!-- ══════════════════════════════════════════════════ -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">

        <!-- 시간표 카드 — TodayPage 동일 스타일 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource CardHeaderBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <Grid RowDefinitions="34,Auto">

            <Border Grid.Row="0" Classes="card-header">
              <TextBlock Text="📚 내 시간표"
                         FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Padding="0">
    <ctrl:TimetableControl x:Name="Timetable" Width="280" AllowLessonClick="True"/>

            </Border>
          </Grid>
        </Border>

        <!-- 할일 -->
        <ctrl:KAgendaControl Grid.Row="1"
                             x:Name="LessonTaskList"
                             FixedCalendarName="수업"
                             Background="Transparent"/>
      </Grid>

      <!-- ══════════════════════════════════════════════════ -->
      <!-- 우측: 오늘의 수업 + 기록 + 메모                    -->
      <!-- ══════════════════════════════════════════════════ -->
      <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="8">

        <!-- 최근 수업 기록 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <ctrl:LessonLogList x:Name="LessonLogList"/>
        </Border>

        <!-- 수업 메모 -->
        <board:MemoBoard x:Name="LessonMemoBoard"
                         Grid.Row="1"
                         ShowFilter="False"
                         FixedCategory="수업"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
