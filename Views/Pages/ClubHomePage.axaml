<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             x:Class="SaemDesk.Views.Pages.ClubHomePage"
             x:DataType="vm:ClubHomePageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,*" Margin="20,16">

    <!-- 헤더 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="🎭 동아리홈" FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
      <TextBlock Text="학년도" VerticalAlignment="Center" Margin="14,0,4,0"/>
      <NumericUpDown Value="{Binding Year, Mode=TwoWay}" Minimum="2000" Maximum="2100"
                     Width="100"/>
      <Button Content="새로고침" Padding="10,6"
              Command="{Binding ReloadCommand}"/>
      <ProgressBar Width="100" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- 본문 -->
    <Grid Grid.Row="1">

      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="6">
        <TextBlock Text="등록된 동아리가 없습니다."
                   FontSize="15"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Text="‘동아리 관리’ 메뉴에서 동아리를 추가하세요."
                   FontSize="12"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Clubs}" Margin="0,4">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ClubCardVM">
              <Border Width="240" Height="120"
                      Margin="0,0,12,12"
                      Padding="14,10"
                      Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      BorderBrush="CornflowerBlue"
                      BorderThickness="1"
                      CornerRadius="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}"
                             FontWeight="SemiBold" FontSize="15"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding YearText}"
                             FontSize="11"
                             Foreground="{DynamicResource SystemBaseMediumColor}"/>
                  <TextBlock Text="{Binding Room}"
                             FontSize="12"/>
                  <TextBlock Text="{Binding MemberText}"
                             FontSize="12"
                             Foreground="#5B7FB8"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Remark}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
