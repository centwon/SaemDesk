<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.ClubHomePage"
             x:DataType="vm:ClubHomePageVM"
             Classes="page">

    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── 헤더 ─────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
      <TextBlock Text="동아리 홈" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="내 동아리 현황"
                 FontSize="14"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </StackPanel>

    <!-- ── 본문: 좌(동아리 정보 + 부원) / 우(자료실) ───── -->
    <Grid Grid.Row="1" ColumnDefinitions="320,*">

      <!-- 좌측: 동아리 선택 + 부원 명단 -->
      <Grid Grid.Column="0" Margin="0,0,16,0" RowDefinitions="Auto,*">

        <!-- 동아리 선택 카드 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="16" Margin="0,0,0,12">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="동아리 선택" FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <ComboBox Name="CBoxClub"
                        ItemsSource="{Binding Clubs}"
                        SelectedItem="{Binding SelectedClub, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnClubChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="models:Club">
                    <TextBlock Text="{Binding ClubName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <TextBlock Name="TxtClubInfo" Text=""
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Name="TxtMemberCount" Text=""
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

            <Button Content="활동 기록"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Click="OnActivityClick"/>
          </StackPanel>
        </Border>

        <!-- 부원 명단 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="8">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    Padding="16,12" CornerRadius="8,8,0,0">
              <TextBlock Text="👥 부원 명단" FontWeight="SemiBold"/>
            </Border>

            <ListBox Grid.Row="1"
                     Name="MemberListView"
                     ItemsSource="{Binding Members}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:ClubEnrollment">
                  <Grid ColumnDefinitions="*" Margin="4,2">
                    <TextBlock Text="{Binding StudentID}"
                               FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 빈 상태 -->
            <StackPanel Grid.Row="1"
                        Name="EmptyMemberState"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <TextBlock Text="등록된 부원이 없습니다"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 우측: 자료실 -->
      <Border Grid.Column="1"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                  Padding="12,8" CornerRadius="8,8,0,0">
            <TextBlock Text="📋 동아리 자료실" FontWeight="SemiBold"/>
          </Border>
          <TextBlock Grid.Row="1"
                     Text="동아리를 선택하면 관련 게시글이 표시됩니다."
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     FontSize="13"/>
        </Grid>
      </Border>
    </Grid>
    </Grid>
</UserControl>
