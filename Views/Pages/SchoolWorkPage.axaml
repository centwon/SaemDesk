<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.SchoolWorkPage"
             x:DataType="vm:SchoolWorkPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="380,*" Margin="20,16">

    <!-- 헤더 -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="📋 업무"
                 FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
      <TextBlock Text="{Binding TodayText}"
                 FontSize="13"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 VerticalAlignment="Center"/>
      <Button Content="새로고침" Padding="10,6"
              Command="{Binding ReloadCommand}"/>
      <ProgressBar Width="100" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- 좌: 업무 메모 -->
    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
      <ctrl:MemoBoard/>
    </Border>

    <!-- 우: 업무 게시판 -->
    <Border Grid.Row="1" Grid.Column="1"
            BorderThickness="1"
            BorderBrush="{DynamicResource ContentSeparatorBrush}"
            CornerRadius="6">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="10,6">
          <TextBlock Text="📋 업무 게시판" FontWeight="SemiBold"/>
        </Border>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding WorkPosts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:Post">
                <Border BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource ContentSeparatorBrush}"
                        Padding="12,8">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding DateTimeDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding User}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemBaseMediumLowColor}"
                               Margin="0,2,0,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
