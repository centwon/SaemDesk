<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.BoardPage"
             x:DataType="vm:BoardPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ── 헤더 ──────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Margin="20,20,20,0" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="✎"
                   FontSize="22"
                   Foreground="{StaticResource BrandPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <TextBlock Text="게시판"
                   FontSize="22"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusText}"
                   FontSize="13"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"/>
      </StackPanel>
    </StackPanel>

    <!-- ── 툴바 ─────────────────────────────────────────── -->
    <Grid Grid.Row="1" Margin="20,12,20,0" ColumnDefinitions="Auto,*,Auto">

      <!-- 카테고리 필터 -->
      <ComboBox Grid.Column="0"
                MinWidth="140"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>

      <!-- 검색 -->
      <TextBox Grid.Column="1"
               Margin="8,0,0,0"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="제목·본문·작성자로 검색…"/>

      <!-- 액션 -->
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="8,0,0,0">

        <Button Content="새 글"
                Command="{Binding AddPostCommand}"
                Classes="accent"
                Padding="12,6"/>

        <Button Content="보기"
                Command="{Binding ViewSelectedPostCommand}"
                IsEnabled="{Binding HasSelection}"
                Padding="12,6"/>

        <Button Content="수정"
                Command="{Binding EditSelectedPostCommand}"
                IsEnabled="{Binding HasSelection}"
                Padding="12,6"/>

        <Button Content="삭제"
                Command="{Binding DeleteSelectedPostCommand}"
                IsEnabled="{Binding HasSelection}"
                Padding="12,6"/>

        <Button Content="새로고침"
                Command="{Binding LoadPostsCommand}"
                Padding="12,6"/>

      </StackPanel>
    </Grid>

    <!-- ── 본문 ──────────────────────────────────────────── -->
    <Panel Grid.Row="2">

      <ProgressBar IsVisible="{Binding IsLoading}"
                   IsIndeterminate="True"
                   VerticalAlignment="Top"
                   Margin="20,8,20,0"/>

      <TextBlock IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding ErrorText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemErrorTextColor}"
                 FontSize="13"/>

      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="등록된 게시글이 없습니다."
                   FontSize="15"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Text="'새 글' 버튼으로 첫 글을 작성하세요."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
      </StackPanel>

      <ListBox IsVisible="{Binding HasPosts}"
               ItemsSource="{Binding Posts}"
               SelectedItem="{Binding SelectedPost, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               Margin="20,4,20,20">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:Post">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">

              <!-- 카테고리 배지 -->
              <Border Grid.Column="0"
                      VerticalAlignment="Center"
                      Padding="8,3"
                      Margin="0,0,12,0"
                      CornerRadius="4"
                      MinWidth="56"
                      Background="{StaticResource BrandPrimaryBrush}">
                <TextBlock Text="{Binding Category}"
                           FontSize="11"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
              </Border>

              <!-- 제목 + 작성자 -->
              <StackPanel Grid.Column="1"
                          VerticalAlignment="Center"
                          Spacing="2">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding User}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
              </StackPanel>

              <!-- 날짜 + 조회수 -->
              <StackPanel Grid.Column="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Spacing="2">
                <TextBlock Text="{Binding DateTimeDisplay}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                <TextBlock Text="{Binding ReadCount, StringFormat=조회 {0}}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
              </StackPanel>

            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>

        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="0 1 4 0 #18000000">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
              </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border">
              <Setter Property="Background" Value="{DynamicResource SystemListLowColor}"/>
              <Setter Property="BoxShadow" Value="0 2 8 0 #30000000"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border">
              <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}"/>
            </Style>
          </ControlTheme>
        </ListBox.ItemContainerTheme>

      </ListBox>

    </Panel>
  </Grid>
</UserControl>
