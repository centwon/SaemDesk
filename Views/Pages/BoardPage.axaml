<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:boardPages="using:SaemDesk.Board.Views.Pages"
             x:Class="SaemDesk.Views.Pages.BoardPage">

  <!--
    BoardPage — PostListPage / PostDetailPage / PostEditPage 를 하나의 컨테이너에서 관리.
    NewSchool의 Frame 네비게이션을 이벤트 기반 ContentControl 전환으로 대체.
  -->
  <Grid>
    <!-- List -->
    <boardPages:PostListPage x:Name="ListPage" IsVisible="True"/>
    <!-- Detail -->
    <boardPages:PostDetailPage x:Name="DetailPage" IsVisible="False"/>
    <!-- Edit -->
    <boardPages:PostEditPage x:Name="EditPage" IsVisible="False"/>
  </Grid>

</UserControl>
