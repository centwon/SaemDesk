<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             x:Class="SaemDesk.Views.Pages.LessonsPage"
             x:DataType="vm:LessonsPageVM"
             Classes="page">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <TextBlock Text="수업" FontSize="28" FontWeight="Bold"
               HorizontalAlignment="Center" />
    <TextBlock Text="Phase 5 구현 예정 — TimetableViewModel + AnnualLessonPlanViewModel 통합"
               Foreground="{DynamicResource SystemBaseMediumColor}"
               HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
