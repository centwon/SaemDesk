<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.LessonsPage"
             x:DataType="vm:LessonsPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

    <!-- ── 헤더 ──────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Margin="20,20,20,0" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="◇"
                   FontSize="22"
                   Foreground="{StaticResource BrandPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ClassHeaderText}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusText}"
                   FontSize="13"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding SchoolYearText}"
                 FontSize="13"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- ── 요일 탭 ────────────────────────────────────────── -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="20,12,20,0"
                Spacing="6">
      <Button Content="월" Command="{Binding SelectMonCommand}"
              Classes.accent="{Binding IsMonSelected}" Padding="14,6"/>
      <Button Content="화" Command="{Binding SelectTueCommand}"
              Classes.accent="{Binding IsTueSelected}" Padding="14,6"/>
      <Button Content="수" Command="{Binding SelectWedCommand}"
              Classes.accent="{Binding IsWedSelected}" Padding="14,6"/>
      <Button Content="목" Command="{Binding SelectThuCommand}"
              Classes.accent="{Binding IsThuSelected}" Padding="14,6"/>
      <Button Content="금" Command="{Binding SelectFriCommand}"
              Classes.accent="{Binding IsFriSelected}" Padding="14,6"/>
      <Button Content="새로고침"
              Command="{Binding LoadTimetableCommand}"
              Margin="8,0,0,0"
              Padding="12,6"/>
    </StackPanel>

    <!-- ── CRUD 툴바 ──────────────────────────────────────── -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="20,8,20,0"
                Spacing="6">
      <Button Content="추가"
              Command="{Binding AddSlotCommand}"
              Classes="accent"
              Padding="14,6"/>
      <Button Content="수정"
              Command="{Binding EditSelectedSlotCommand}"
              IsEnabled="{Binding HasSelection}"
              Padding="12,6"/>
      <Button Content="삭제"
              Command="{Binding DeleteSelectedSlotCommand}"
              IsEnabled="{Binding HasSelection}"
              Padding="12,6"/>
    </StackPanel>

    <!-- ── 선택 요일 표시 ─────────────────────────────────── -->
    <TextBlock Grid.Row="3"
               Text="{Binding SelectedDayName}"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="{StaticResource BrandPrimaryBrush}"
               Margin="20,12,20,0"/>

    <!-- ── 본문 ──────────────────────────────────────────── -->
    <Panel Grid.Row="4">

      <!-- 로딩 중 -->
      <ProgressBar IsVisible="{Binding IsLoading}"
                   IsIndeterminate="True"
                   VerticalAlignment="Top"
                   Margin="20,8,20,0"/>

      <!-- 오류 -->
      <TextBlock IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding ErrorText}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemErrorTextColor}"
                 FontSize="13"/>

      <!-- 빈 상태 -->
      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="등록된 시간표가 없습니다."
                   FontSize="15"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Text="'추가' 버튼으로 첫 시간표를 등록하세요."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"/>
      </StackPanel>

      <!-- 시간표 목록 -->
      <ListBox IsVisible="{Binding HasSlots}"
               ItemsSource="{Binding DaySlots}"
               SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               Margin="20,8,20,20">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:ClassTimetable">
            <Grid ColumnDefinitions="40,*,Auto">

              <!-- 교시 배지 -->
              <Border Grid.Column="0"
                      Width="32" Height="32"
                      CornerRadius="16"
                      Background="{StaticResource BrandPrimaryBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding Period}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>

              <!-- 과목 + 교사 -->
              <StackPanel Grid.Column="1"
                          Margin="12,0,8,0"
                          VerticalAlignment="Center"
                          Spacing="2">
                <TextBlock Text="{Binding SubjectName}"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TeacherName}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
              </StackPanel>

              <!-- 강의실 -->
              <Border Grid.Column="2"
                      IsVisible="{Binding Room, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      VerticalAlignment="Center"
                      Padding="8,3"
                      CornerRadius="4"
                      Background="{DynamicResource SystemListLowColor}">
                <TextBlock Text="{Binding Room}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
              </Border>

            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>

        <!-- 항목 컨테이너 — 카드 스타일 -->
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="0 1 4 0 #18000000">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
              </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border">
              <Setter Property="Background" Value="{DynamicResource SystemListLowColor}"/>
              <Setter Property="BoxShadow" Value="0 2 8 0 #30000000"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border">
              <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}"/>
            </Style>
          </ControlTheme>
        </ListBox.ItemContainerTheme>

      </ListBox>

    </Panel>
  </Grid>
</UserControl>
