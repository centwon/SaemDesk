<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.StudentLogPage"
             x:DataType="vm:StudentLogPageVM"
             Classes="page">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── 필터 및 버튼 영역 ─────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 필터 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <ctrl:ClassFilterBar x:Name="FilterBar"
                               ShowSemester="True"
                               IncludeAllClass="False"/>
          <ComboBox Name="CBoxCategory"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    SelectionChanged="OnCategoryChanged"/>
        </StackPanel>

        <!-- 오른쪽: 기록 관련 버튼 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">

          <!-- 그룹1: 개별 기록 편집 -->
          <Button Name="BtnNewActLog" Padding="12,6" Click="BtnNewActLog_Click">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="➕" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="추가" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Name="BtnSaveActLog" Padding="12,6" Click="BtnSaveActLog_Click" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="저장" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Name="BtnEditLog" Padding="12,6" Click="BtnEditLog_Click">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="✏" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="상세" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Name="BtnPrint" Padding="12,6" Click="BtnPrint_Click">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="🖨" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="인쇄" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Name="BtnDelActLog" Padding="12,6" Click="BtnDelActLog_Click">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="🗑" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="삭제" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- 세로 구분선 -->
          <Border Width="1" Margin="4,4" VerticalAlignment="Stretch"
                  Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

          <!-- 그룹2: 일괄 작업 -->
          <Button Name="BtnAddLogAll" ToolTip.Tip="일괄 입력" Padding="10,6" Click="BtnAddLogAll_Click">
            <TextBlock Text="📝" FontSize="20" VerticalAlignment="Center"/>
          </Button>
          <Button Name="BtnBatchExport" ToolTip.Tip="일괄 출력" Padding="10,6" Click="BtnBatchExport_Click">
            <TextBlock Text="📤" FontSize="20" VerticalAlignment="Center"/>
          </Button>

          <!-- 세로 구분선 -->
          <Border Width="1" Margin="4,4" VerticalAlignment="Stretch"
                  Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

          <!-- 글꼴 크기 -->
          <Button Name="BtnFontResize" ToolTip.Tip="글자 크기 변경" Padding="8,6">
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Grid Width="180" Height="140" Margin="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Stretch" Spacing="4" Width="36">
                    <TextBlock x:Name="TbMax" Text="30" FontSize="9" HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,4,4,0"/>
                    <TextBlock x:Name="TbSize" Text="12" FontWeight="Bold" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                    <TextBlock x:Name="TbMin" Text="6" FontSize="9" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Margin="0,0,4,4"/>
                  </StackPanel>
                  <Slider x:Name="SldFontSize"
                          Grid.Column="1"
                          Orientation="Vertical"
                          Minimum="6" Maximum="30" Value="12"
                          TickFrequency="2" IsSnapToTickEnabled="True"
                          VerticalAlignment="Stretch"
                          ValueChanged="SldFontSize_ValueChanged"/>
                </Grid>
              </Flyout>
            </Button.Flyout>
            <TextBlock Text="🔠" FontSize="20" VerticalAlignment="Center"/>
          </Button>

        </StackPanel>
      </Grid>
    </Border>

    <!-- ── 본문: 학생 목록(좌) + 로그 목록(우) ──────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="160,8,*" Margin="12,0,12,12">
      <ctrl:ListStudent Name="StudentList" Grid.Column="0"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ctrl:LogListViewer Name="LogList" Grid.Row="0"/>
        <ctrl:StudentSpecBox Name="SpecBox" Grid.Row="1" Height="200"
                             IsVisible="False" Margin="0,8,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
