<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.ClubActivityPage"
             x:DataType="vm:ClubActivityPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,12,*">

    <!-- ── 헤더 ─────────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="동아리 활동" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

        <Border Width="1" Height="20"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                VerticalAlignment="Center"/>

        <ComboBox Name="CBoxClub"
                  ItemsSource="{Binding Clubs}"
                  SelectedItem="{Binding SelectedClub, Mode=TwoWay}"
                  MinWidth="180"
                  SelectionChanged="OnClubChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:Club">
              <TextBlock Text="{Binding ClubName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Name="TxtMemberCount" Text="0명" FontSize="12"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   VerticalAlignment="Center"/>

        <Border Width="1" Height="20"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                VerticalAlignment="Center"/>

        <ComboBox Name="CBoxCategory"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                  MinWidth="100"
                  SelectionChanged="OnCategoryChanged"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Name="BtnAddLog"    Content="추가"  Click="BtnAddLog_Click"/>
        <Button Name="BtnSaveLog"   Content="저장"  Classes="accent" Click="BtnSaveLog_Click"/>
        <Button Name="BtnDeleteLog" Content="삭제"  Click="BtnDeleteLog_Click"/>
        <Button Name="BtnRefresh"   Content="⟳"    Padding="8,6" Click="BtnRefresh_Click"/>

        <Border Width="1" Margin="4,4" VerticalAlignment="Stretch"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

        <Button Name="BtnClubManage" ToolTip.Tip="동아리 관리" Click="BtnClubManage_Click">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="🎪" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="동아리 관리" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ── 본문 ─────────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="220,12,*">

      <!-- 부원 목록 (좌) -->
      <ctrl:ListStudent Name="StudentList" Grid.Column="0" ViewMode="Full"/>

      <!-- 기록 목록 + StudentSpecBox (우) -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto">

        <ctrl:LogListViewer Name="LogList" Grid.Row="0" StudentInfoMode="HideAll"/>

        <ctrl:StudentSpecBox Name="SpecBox"
                             Grid.Row="1"
                             Height="180"
                             IsVisible="False"
                             Margin="0,12,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
