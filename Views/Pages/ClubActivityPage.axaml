<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.ClubActivityPage"
             x:DataType="vm:ClubActivityPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,*" Margin="20,16">

    <!-- 헤더 -->
    <Grid Grid.Row="0" Grid.ColumnSpan="2"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
          Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="🎭 동아리 활동"
                 FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Clubs}"
                SelectedItem="{Binding SelectedClub, Mode=TwoWay}"
                MinWidth="200"
                PlaceholderText="동아리 선택"
                Margin="14,0,4,0">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="models:Club">
            <TextBlock Text="{Binding ClubName}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="새로고침"
              Padding="10,6"
              Command="{Binding ReloadMembersAndLogsCommand}"/>
      <ProgressBar Grid.Column="3" Width="80" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   VerticalAlignment="Center" Margin="8,0"/>
      <TextBlock Grid.Column="6" Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </Grid>

    <!-- 좌: 부원 -->
    <Border Grid.Row="1" Grid.Column="0"
            BorderThickness="1" BorderBrush="{DynamicResource ContentSeparatorBrush}"
            CornerRadius="6" Margin="0,0,10,0">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="10,6">
          <TextBlock Text="{Binding MemberCount, StringFormat=부원 ({0}명)}"
                     FontWeight="SemiBold"/>
        </Border>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:ClubEnrollment">
                <Border BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource ContentSeparatorBrush}"
                        Padding="10,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StudentID}"
                               FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 우: 활동 기록 -->
    <Border Grid.Row="1" Grid.Column="1"
            BorderThickness="1" BorderBrush="{DynamicResource ContentSeparatorBrush}"
            CornerRadius="6">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="10,6">
          <TextBlock Text="{Binding LogCount, StringFormat=활동 기록 ({0}건)}"
                     FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:StudentLog">
                <Border BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource ContentSeparatorBrush}"
                        Padding="12,8">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding Date, StringFormat=yyyy-MM-dd}"
                                 FontWeight="SemiBold"
                                 Foreground="#5B7FB8"/>
                      <TextBlock Grid.Column="2" Text="{Binding TeacherID}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    </Grid>
                    <TextBlock Text="{Binding Log}"
                               TextWrapping="Wrap"
                               FontSize="13"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ContentSeparatorBrush}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Name="LogInput"
                     PlaceholderText="활동 내용 입력 후 Enter 또는 ‘추가’ 클릭"
                     AcceptsReturn="False"
                     KeyDown="OnLogInputKeyDown"/>
            <Button Grid.Column="1" Content="＋ 추가"
                    Padding="12,6" Margin="6,0,0,0"
                    Classes="accent"
                    Click="OnAddLogClick"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
