<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.TeacherTimetablePage"
             Classes="page">

  <Grid RowDefinitions="Auto,12,*">

    <!-- ── 헤더 ─────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <TextBlock Text="교사 시간표" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

      <Border Width="1" Height="20"
              Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
              VerticalAlignment="Center"/>

      <ctrl:YearSemesterPicker x:Name="YearSemPicker"
                               ShowYear="True" ShowSemester="True"
                               VerticalAlignment="Center"
                               YearSemesterChanged="OnYearSemesterChanged"/>

      <ProgressBar x:Name="BusyBar" Width="80" Height="4"
                   IsIndeterminate="True" IsVisible="False"
                   VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ── 시간표 ──────────────────────────────────────── -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
      <ctrl:TimetableControl x:Name="TimetableCtrl" DisplayMode="Teacher"/>
    </Border>

  </Grid>
</UserControl>
