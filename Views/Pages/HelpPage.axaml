<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             x:Class="SaemDesk.Views.Pages.HelpPage"
             x:DataType="vm:HelpPageVM"
             Classes="page">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,16" Spacing="12" MaxWidth="760">

      <!-- 페이지 제목 -->
      <TextBlock Text="도움말" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="SaemDesk 사용 가이드 — 메뉴 구조, 주요 기능, 단축키, 데이터 관리 방법을 안내합니다."
                 FontSize="12"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 Margin="0,0,0,8"/>

      <!-- ────────── 시작하기 ────────── -->
      <Expander Header="처음 시작할 때" IsExpanded="True">
        <StackPanel Margin="0,8,0,4" Spacing="6">
          <TextBlock TextWrapping="Wrap">
            <Run FontWeight="SemiBold">1.</Run>
            <Run Text=" 설정 → 학교 설정에서 [학교 검색 (NEIS)] 버튼으로 본인 학교를 등록합니다."/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run FontWeight="SemiBold">2.</Run>
            <Run Text=" 본인 이름, 담당 학년·반을 입력합니다."/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run FontWeight="SemiBold">3.</Run>
            <Run Text=" 학년도와 학기를 현재 시점에 맞춰 설정합니다."/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run FontWeight="SemiBold">4.</Run>
            <Run Text=" 설정 → 학생 관리에서 학급 명렬을 등록합니다."/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run FontWeight="SemiBold">5.</Run>
            <Run Text=" 수업 → 수업 관리에서 담당 과목을 등록하면 모든 기능을 사용할 수 있습니다."/>
          </TextBlock>
        </StackPanel>
      </Expander>

      <!-- ────────── 메뉴 구조 ────────── -->
      <Expander Header="메뉴 구조">
        <StackPanel Margin="0,8,0,4" Spacing="10">

          <StackPanel Spacing="2">
            <TextBlock Text="🏠 홈" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="오늘의 시간표, 급식, 일정을 한 화면에 보여 줍니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="📅 달력" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="월간 달력에서 일정을 확인하고 관리합니다. Google Calendar 연동 시 양방향 동기화됩니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="👥 학급" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="학급 일지 · 학생 정보 · 학생 기록 · 학생부 관리 · 자리 배정 · 학급 게시판 · 학생정보 출력 · 통합 내보내기 · 학급 시간표 관리"/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="📚 수업" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="수업홈 · 누가 기록 · 교과 세부능력 및 특기 사항 · 수업 시간표 · 수업 게시판 · 수업 관리 · 동아리 활동"/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="💼 업무" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="업무 관리 · 업무 게시판"/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="🗃 아카이브" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="카테고리별 자료를 보관하고 검색합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="⚙ 설정" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="학교 설정 · 학사일정 관리 · 학생 관리 · 앱 설정 · 도움말 · 업데이트 확인"/>
          </StackPanel>

        </StackPanel>
      </Expander>

      <!-- ────────── 주요 기능 안내 ────────── -->
      <Expander Header="주요 기능 안내">
        <StackPanel Margin="0,8,0,4" Spacing="10">

          <StackPanel Spacing="2">
            <TextBlock Text="📓 학급 일지" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="날짜별 학급일지를 작성합니다. 출결, 특이사항, 식단 등을 한 페이지에 기록합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="👤 학생 정보 / ✏ 학생 기록" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="학생 카드에서 기본 정보를 확인하고 누가기록을 작성합니다. 일괄 내보내기로 Excel, PDF, HTML, CSV 출력이 가능합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="📋 교과 세부능력 및 특기 사항" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="과목별 학생부 특기사항을 작성하고 관리합니다. 학년도/학기 필터와 과목 선택 후 학생별로 기록하며, 일괄 내보내기를 지원합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="🪑 자리 배정" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="교실 좌석 배치도를 드래그 앤 드롭으로 구성합니다. 랜덤 배정 기능도 제공합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="🗓 시간표" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="주간 시간표를 시각적으로 편집합니다. 한 칸 클릭으로 과목을 추가하거나 수정합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="🎭 동아리 활동" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="동아리 활동 기록을 작성합니다. 페이지 내 [동아리 관리] 버튼으로 동아리 CRUD 및 부원 관리 화면에 진입할 수 있습니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="📚 수업 관리" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="담당 과목(교과, 분반 등)을 등록하고 관리합니다. 수업 관련 기능의 기초 데이터입니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="📌 게시판" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="공지, 메모, 할일을 카테고리별로 정리합니다. 본문은 Jodit HTML 에디터로 작성하며 이미지, 표, 링크를 지원합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="💼 업무 관리" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="학교 업무를 등록하고 진행 상태를 관리합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="📅 학사일정 관리" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="NEIS에서 본교 학사일정을 가져와 달력에 표시합니다. Google Calendar로 일괄 업로드할 수도 있습니다."/>
          </StackPanel>

        </StackPanel>
      </Expander>

      <!-- ────────── 단축키 ────────── -->
      <Expander Header="단축키">
        <Grid Margin="0,8,0,4" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="140,*">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + N" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="새 항목 추가 (동아리 관리, 수업 관리)" Margin="0,0,0,6"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + S" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="저장 (게시글 편집, 학사일정, 자리 배정 등)" Margin="0,0,0,6"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Z" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="실행 취소 (편집기 내)" Margin="0,0,0,6"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Esc" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="다이얼로그 닫기" Margin="0,0,0,6"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>
        </Grid>
      </Expander>

      <!-- ────────── 데이터 / 백업 ────────── -->
      <Expander Header="데이터와 백업">
        <StackPanel Margin="0,8,0,4" Spacing="6">
          <TextBlock TextWrapping="Wrap"
                     Text="모든 데이터는 SQLite DB 파일로 저장됩니다. 실행 파일 옆에 Settings.db가 있으면 포터블 모드, 없으면 사용자 폴더(%USERPROFILE%\SaemDesk)에 저장됩니다."/>
          <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     FontSize="12">
            <Run Text="school.db"/>
            <Run Text=" — 학생, 수업, 학급일지, 동아리 등 핵심 데이터"/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     FontSize="12">
            <Run Text="board.db"/>
            <Run Text=" — 게시판 글, 카테고리"/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     FontSize="12">
            <Run Text="scheduler.db"/>
            <Run Text=" — 일정, Google Calendar 동기화 상태"/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     FontSize="12">
            <Run Text="Settings.db"/>
            <Run Text=" — 앱 설정, 학교 정보, 사용자 정보"/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="설정의 [자동 백업] 옵션을 켜면 앱 종료 시 Backups 폴더에 날짜별 사본이 저장됩니다. 비정상 종료 대비를 위해 권장합니다."
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     FontSize="11"/>
        </StackPanel>
      </Expander>

      <!-- ────────── 자주 묻는 질문 ────────── -->
      <Expander Header="자주 묻는 질문 (FAQ)">
        <StackPanel Margin="0,8,0,4" Spacing="10">

          <StackPanel Spacing="2">
            <TextBlock Text="Q. 데이터를 다른 PC로 옮기고 싶습니다." FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="A. 데이터 폴더의 *.db 파일들을 새 PC의 같은 위치에 복사하면 됩니다. 포터블 모드라면 앱 폴더 전체를 복사합니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Q. 일괄 내보내기에서 아무 일도 일어나지 않습니다." FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="A. 학년/반 또는 과목과 학생이 선택되어 있는지 확인하세요. 조건에 맞는 데이터가 없으면 안내 메시지가 표시됩니다."/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Q. 동아리 관리는 어디에 있나요?" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="A. 수업 → 동아리 활동 페이지 안의 [동아리 관리] 버튼으로 진입합니다. 동아리 추가/수정/삭제 및 부원 관리를 할 수 있습니다."/>
          </StackPanel>

        </StackPanel>
      </Expander>

      <!-- ────────── 버전 정보 ────────── -->
      <StackPanel Margin="0,12,0,16" Spacing="2" HorizontalAlignment="Right">
        <TextBlock Text="{Binding AppVersion}"
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="© 2026 Centwons"
                   FontSize="10"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"
                   HorizontalAlignment="Right"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
