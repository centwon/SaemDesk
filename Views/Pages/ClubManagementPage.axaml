<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.ClubManagementPage"
             x:DataType="vm:ClubManagementPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 헤더 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="🎭 동아리 관리" Classes="page-title"/>
        <TextBlock Text="학년도별 담당 동아리 CRUD 및 부원 관리"
                   Classes="page-subtitle"/>
      </StackPanel>
      <Button Grid.Column="1" Click="BtnBackToActivity_Click"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="←" FontSize="16" VerticalAlignment="Center"/>
          <TextBlock Text="동아리 활동" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- 필터 / 툴바 -->
    <Grid Grid.Row="1" Margin="0,8,0,8"
          ColumnDefinitions="Auto,Auto,Auto">

      <!-- 학년도 피커 (학기 제외) -->
      <ctrl:YearSemesterPicker Grid.Column="0"
                               x:Name="YearPicker"
                               ShowYear="True" ShowSemester="False"
                               Margin="0,0,12,0"
                               YearSemesterChanged="OnYearSemesterChanged"/>

      <!-- 액션 버튼 -->
      <Button Grid.Column="1" Content="동아리 추가" Classes="accent"
              Command="{Binding AddClubCommand}"
              HotKey="Ctrl+N"
              Margin="0,0,6,0"/>
      <Button Grid.Column="2" Content="새로고침"
              Command="{Binding QueryCommand}"/>
    </Grid>

    <!-- 본문: 동아리 카드 목록 -->
    <Grid Grid.Row="2" Margin="0,0,0,8">

      <!-- 빈 상태 -->
      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="🎭" FontSize="48" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Text="등록된 동아리가 없습니다"
                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="[동아리 추가] 버튼으로 새 동아리를 등록하세요"
                   FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
      </StackPanel>

      <!-- 카드 목록 -->
      <ScrollViewer IsVisible="{Binding HasClubs}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:Club">
              <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      BorderThickness="1" CornerRadius="8"
                      Margin="0,0,0,8" Padding="16">
                <Grid ColumnDefinitions="*,Auto">

                  <!-- 좌: 동아리 정보 -->
                  <StackPanel Grid.Column="0" Spacing="8">

                    <!-- 동아리명 + 학년도 배지 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ClubName}"
                                 FontSize="16" FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                      <Border Background="{DynamicResource SystemAccentColor}"
                              CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding Year, StringFormat='{}{0}학년도'}"
                                   FontSize="11" Foreground="White"/>
                      </Border>
                    </StackPanel>

                    <!-- 지도교사 -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <TextBlock FontSize="13">
                        <Run Text="지도교사: "/>
                        <Run Text="{Binding $parent[UserControl].((vm:ClubManagementPageVM)DataContext).TeacherName}" FontWeight="SemiBold"/>
                      </TextBlock>
                    </StackPanel>

                    <!-- 활동실 배지 -->
                    <Border Background="{DynamicResource SystemListLowColor}"
                            CornerRadius="4" Padding="8,3"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding ActivityRoom,
                              Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock FontSize="12">
                        <Run Text="📍 "/>
                        <Run Text="{Binding ActivityRoom}" FontWeight="SemiBold"/>
                      </TextBlock>
                    </Border>

                    <!-- 비고 -->
                    <TextBlock Text="{Binding Remark}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               IsVisible="{Binding Remark,
                                 Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- 우: 액션 버튼 -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal"
                              Spacing="6" VerticalAlignment="Center">
                    <Button Content="👥 부원 관리"
                           
                            ToolTip.Tip="부원 등록/해제 관리"
                            Command="{Binding $parent[UserControl].((vm:ClubManagementPageVM)DataContext).EnrollMembersCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Content="✏ 수정"
                            Classes="accent"
                            Command="{Binding $parent[UserControl].((vm:ClubManagementPageVM)DataContext).EditItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Content="🗑"
                           
                            ToolTip.Tip="삭제"
                            Command="{Binding $parent[UserControl].((vm:ClubManagementPageVM)DataContext).DeleteItemCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 로딩 오버레이 -->
      <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource LoadingOverlayBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <ProgressBar Width="160" IsIndeterminate="True"/>
          <TextBlock Text="조회 중…" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 상태바 -->
    <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                 FontSize="11"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding ErrorText}"
                 FontSize="11" Foreground="{DynamicResource ErrorForegroundBrush}"
                 VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>
