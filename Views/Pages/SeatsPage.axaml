<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             x:Class="SaemDesk.Views.Pages.SeatsPage"
             x:DataType="vm:SeatsPageVM"
             Classes="page">

  <Grid ColumnDefinitions="200,*">

    <!-- ══ 좌측: 학년/반 필터 + 학생 명렬 ══ -->
    <Border Grid.Column="0"
            BorderBrush="{DynamicResource ContentSeparatorBrush}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

      <!-- 학년/반 필터 -->
      <ctrl:ClassPicker x:Name="ClassFilter"
                        Grid.Row="0"
                        IncludeAllClass="False"
                        Margin="8,8,8,6"/>

      <!-- 학생 명렬: AllowMultiSelect=True → 배치 완료 학생 선택 표시 -->
      <ctrl:ListStudent Grid.Row="1"
                        x:Name="StudentList"
                        ViewMode="NumName"
                        ShowCheckBox="False"
                        AllowMultiSelect="True"
                        Margin="8,0,8,8"/>
      </Grid>
    </Border>

    <!-- ══ 우측 ══ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 우측 헤더 -->
      <Grid Grid.Row="0" Margin="12,8,12,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: ● 자리 배정 + 배열 + 버튼들 -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- ● 자리 배정 -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnOptions"
                    Click="BtnOptions_Click"
                    ToolTip.Tip="배치 옵션 (이력/속성/짝제약/방식)"
                    Padding="2"
                    BorderThickness="0"
                    Background="Transparent">
              <TextBlock Text="●" FontSize="10"
                         Foreground="{StaticResource BrandPrimaryBrush}"/>
            </Button>
            <TextBlock Text="자리 배정"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="2,0,16,0"/>
          </StackPanel>

          <!-- 배열 설정: 줄 + 짝 체크 + 도트 패턴 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center">
            <NumericUpDown x:Name="NBoxJul"
                           Value="{Binding Jul, Mode=TwoWay}"
                           Minimum="2" Maximum="8"
                           Width="100" Height="32"
                           Increment="1"
                           FormatString="0'줄'"
                           ValueChanged="NBoxJul_ValueChanged"/>
            <CheckBox x:Name="ChkJJak"
                      Content="짝"
                      IsChecked="{Binding Jjak, Mode=TwoWay}"
                      Click="ChkJJak_Click"
                      VerticalAlignment="Center"
                      Margin="0,0,2,0"/>
            <TextBlock x:Name="TxtDotPattern"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
          </StackPanel>

          <!-- 우측 버튼들 -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center">
            <CheckBox x:Name="ChkViewPhoto"
                      Content="사진 표시"
                      Click="ChkViewPhoto_Click"/>
            <Button x:Name="BtnInit" Content="초기화"
                    Click="BtnInit_Click"/>
            <Button x:Name="BtnArrange" Content="자동배정"
                    Classes="accent"
                    Click="BtnArrange_Click"/>
            <Button x:Name="BtnSave"
                    Click="BtnSave_Click"
                    ToolTip.Tip="저장 (Ctrl+S)">
              <TextBlock Text="💾" FontSize="14"/>
            </Button>
            <ToggleButton x:Name="BtnLock"
                          IsChecked="{Binding IsLocked, Mode=TwoWay}"
                          Click="BtnLock_Click"
                          ToolTip.Tip="배치 잠금 (드래그·재배치 금지)">
              <TextBlock Text="🔒" FontSize="14"/>
            </ToggleButton>
            <Button x:Name="BtnPrint"
                    Click="BtnPrint_Click"
                    ToolTip.Tip="인쇄">
              <TextBlock Text="🖨" FontSize="14"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Row 1: 설명 입력 -->
        <TextBox x:Name="TboxMessage"
                 Grid.Row="1"
                 Text="{Binding Message, Mode=TwoWay}"
                 PlaceholderText="설명 입력..."
                 Margin="0,6,0,0"
                 Height="32" FontSize="12"/>
      </Grid>

      <!-- InfoBar (선택 학생 안내) -->
      <Border x:Name="SelectedStudentBar"
              Grid.Row="1"
              IsVisible="False"
              Background="{DynamicResource SelectedRowBrush}"
              BorderBrush="{DynamicResource InfoBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12,6"
              Margin="12,4,12,0"
              VerticalAlignment="Top"
              ZIndex="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="SelectedStudentText"
                     Grid.Column="0"
                     FontSize="12"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" Padding="6,2"
                  Background="Transparent" BorderThickness="0"
                  Click="BtnCloseInfoBar_Click"/>
        </Grid>
      </Border>

      <!-- 우측 본문: Canvas(좌석) + 교탁 -->
      <Grid Grid.Row="1"
            Background="{DynamicResource ContentBackgroundBrush}"
            Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- 좌석 Canvas -->
        <Canvas x:Name="Room"
                Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                SizeChanged="Room_SizeChanged"/>

        <!-- 교탁 -->
        <Border Grid.Row="1"
                Background="{StaticResource BrandPrimaryBrush}"
                CornerRadius="4"
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0">
          <TextBlock x:Name="TBTable"
                     Text="교탁"
                     FontSize="16" FontWeight="Bold"
                     Foreground="White"/>
        </Border>
      </Grid>

      <!-- 상태 메시지 -->
      <Grid Grid.Row="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Margin="12,0,12,4"
            ColumnDefinitions="*,Auto"
            IsHitTestVisible="False">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding ErrorText}"
                   FontSize="11"
                   Foreground="{DynamicResource ErrorForegroundBrush}"/>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
