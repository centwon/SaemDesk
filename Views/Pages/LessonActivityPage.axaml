<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:ctrl="using:SaemDesk.Views.Controls"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.LessonActivityPage"
             x:DataType="vm:LessonActivityPageVM"
             Classes="page">

  <Border Padding="12">
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── 헤더 영역 ─────────────────────────────────────── -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="수업 활동 기록" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Separator/>

        <StackPanel Spacing="2">
          <TextBlock Text="수업" FontSize="11"/>
          <ComboBox Name="CBoxCourse"
                    ItemsSource="{Binding Courses}"
                    SelectedItem="{Binding SelectedCourse, Mode=TwoWay}"
                    MinWidth="150"
                    SelectionChanged="OnCourseChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="models:Course">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Subject}"/>
                  <TextBlock Text="{Binding TypeDisplay}" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="강의실" FontSize="11"/>
          <ComboBox Name="CBoxRoom"
                    ItemsSource="{Binding Rooms}"
                    SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                    MinWidth="120"
                    SelectionChanged="OnRoomChanged"/>
        </StackPanel>

        <TextBlock Name="TxtStudentCount" Text="0명" FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   VerticalAlignment="Bottom" Margin="8,0,0,2"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Name="BtnBatchInput" Content="일괄입력" Padding="12,6" Click="BtnBatchInput_Click"/>
        <Button Name="BtnAddLog"     Content="추가"     Padding="12,6" Click="BtnAddLog_Click"/>
        <Button Name="BtnEditLog"    Content="편집"     Padding="12,6" Click="BtnEditLog_Click"/>
        <Button Name="BtnSaveLog"    Content="저장"     Padding="12,6" Click="BtnSaveLog_Click" Classes="accent"/>
        <Separator/>
        <Button Name="BtnRefresh"    Content="⟳"        Padding="8,6"  Click="BtnRefresh_Click"/>
        <Separator/>
        <Button Name="BtnDeleteLog"  Content="삭제"     Padding="12,6" Click="BtnDeleteLog_Click"/>
      </StackPanel>
    </Grid>

    <!-- ── 본문: 학생 목록(좌) + 기록 목록(우) ──────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="220,12,*">

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                Padding="12,8" CornerRadius="8,8,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,1,1,0">
          <TextBlock Text="수강생" FontWeight="SemiBold" FontSize="13"/>
        </Border>

        <ctrl:ListStudent Name="StudentList" Grid.Row="1" ViewMode="NumName"/>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctrl:LogListViewer Name="LogList" Grid.Row="0" StudentInfoMode="HideAll"/>

        <ctrl:StudentSpecBox Name="SpecBox"
                             Grid.Row="1"
                             Height="180"
                             IsVisible="False"
                             Margin="0,12,0,0"/>
      </Grid>
    </Grid>
    </Grid>
  </Border>
</UserControl>
