<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaemDesk.ViewModels.Pages"
             xmlns:models="using:SaemDesk.Models"
             x:Class="SaemDesk.Views.Pages.LessonActivityPage"
             x:DataType="vm:LessonActivityPageVM"
             Classes="page">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 헤더 -->
    <StackPanel Grid.Row="0" Margin="20,18,20,4" Spacing="2">
      <TextBlock Text="수업 누가 기록" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="내 차시 기록(LessonLog) — 학기/과목/학급별 필터로 조회"
                 FontSize="12"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- 필터 -->
    <Grid Grid.Row="1" Margin="20,12,20,8"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
      <TextBlock Grid.Column="0" Text="학기" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <NumericUpDown Grid.Column="1"
                     Value="{Binding Semester, Mode=TwoWay}"
                     Minimum="0" Maximum="2" Increment="1"
                     Width="80" Margin="0,0,12,0"
                     ToolTip.Tip="0=전체, 1=1학기, 2=2학기"/>

      <TextBlock Grid.Column="2" Text="과목" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox Grid.Column="3"
                ItemsSource="{Binding Subjects}"
                SelectedItem="{Binding Subject, Mode=TwoWay}"
                MinWidth="120" Margin="0,0,12,0"/>

      <TextBlock Grid.Column="4" Text="학급" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox Grid.Column="5"
                ItemsSource="{Binding ClassLabels}"
                SelectedItem="{Binding ClassLabel, Mode=TwoWay}"
                MinWidth="100" Margin="0,0,12,0"/>

      <Button Grid.Column="6" Content="조회"
              Classes="accent"
              Padding="14,6"
              Command="{Binding QueryCommand}"
              Margin="0,0,12,0"/>

      <TextBox Grid.Column="7"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="과목/주제/내용/메모 검색…"
               MinWidth="200"
               Margin="0,0,12,0"/>

      <Button Grid.Column="8" Content="추가"
              Padding="12,6"
              Command="{Binding AddLogCommand}"
              Margin="0,0,6,0"/>
      <Button Grid.Column="9" Content="편집"
              Padding="12,6"
              IsEnabled="{Binding HasSelection}"
              Command="{Binding EditSelectedCommand}"
              Margin="0,0,6,0"/>
      <Button Grid.Column="10" Content="삭제"
              Padding="12,6"
              IsEnabled="{Binding HasSelection}"
              Command="{Binding DeleteSelectedCommand}"
              Margin="0,0,6,0"/>
      <Button Grid.Column="11" Content="새로고침"
              Padding="12,6"
              Command="{Binding QueryCommand}"/>
    </Grid>

    <!-- 본문 목록 -->
    <Grid Grid.Row="2" Margin="20,0,20,8">
      <ListBox ItemsSource="{Binding Logs}"
               SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="1"
               BorderBrush="{DynamicResource ContentSeparatorBrush}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:LessonLog">
            <Grid ColumnDefinitions="100,Auto,Auto,*,Auto" Margin="6,4">
              <TextBlock Grid.Column="0"
                         Text="{Binding DatePeriodDisplay}"
                         FontSize="11"
                         Foreground="{DynamicResource SystemBaseMediumColor}"
                         VerticalAlignment="Center"/>
              <Border Grid.Column="1"
                      Background="{DynamicResource SystemAccentColor}"
                      CornerRadius="3" Padding="6,1" Margin="6,0"
                      Height="20" VerticalAlignment="Center">
                <TextBlock Text="{Binding Subject}"
                           FontSize="10" Foreground="White"
                           VerticalAlignment="Center"/>
              </Border>
              <TextBlock Grid.Column="2"
                         Text="{Binding ClassDisplay}"
                         FontSize="11" FontWeight="SemiBold"
                         Margin="6,0"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="3" Spacing="2" Margin="6,0">
                <TextBlock Text="{Binding Topic}"
                           FontWeight="SemiBold" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Content}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Column="4"
                         Text="{Binding Room}"
                         FontSize="11"
                         Foreground="{DynamicResource SystemBaseMediumColor}"
                         VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="조회된 차시 기록이 없습니다."
                 IsVisible="{Binding IsEmpty}"
                 FontSize="13"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

      <Border IsVisible="{Binding IsLoading}" Background="#33000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <ProgressBar Width="160" IsIndeterminate="True"/>
          <TextBlock Text="조회 중…" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 상태바 -->
    <Grid Grid.Row="3" Margin="20,0,20,16" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                 FontSize="11"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding ErrorText}"
                 FontSize="11"
                 Foreground="#D9372A"
                 VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>
