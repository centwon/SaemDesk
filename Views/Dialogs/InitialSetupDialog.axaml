<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SaemDesk.Views.Dialogs.InitialSetupDialog"
        Title="프로그램 초기 설정"
        Width="600" Height="740"
        MinWidth="540" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True">

  <Grid RowDefinitions="*,Auto" Margin="24">

    <!-- ── 본문 (스크롤) ─────────────────────────────────── -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="24">

        <!-- 환영 메시지 -->
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="환영합니다!" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="SaemDesk를 사용하기 위해 먼저 기본 정보를 설정해 주세요."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
          </StackPanel>
        </Border>

        <!-- ════════ 1단계: 학교 정보 ════════ -->
        <StackPanel Spacing="10">
          <TextBlock Text="1단계: 학교 정보" FontSize="16" FontWeight="SemiBold"/>
          <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="학교명" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <TextBox x:Name="SchoolNameBox" IsReadOnly="True"
                           PlaceholderText="학교 찾기 버튼으로 검색하세요"/>
                </StackPanel>
                <Button Grid.Column="1" Content="학교 찾기"
                        Classes="accent" VerticalAlignment="Bottom"
                        Padding="14,6" Margin="8,0,0,0"
                        Click="OnSearchSchoolClick"/>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="학교 코드" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <TextBox x:Name="SchoolCodeBox" IsReadOnly="True"
                           PlaceholderText="자동 입력"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="주소" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <TextBox x:Name="SchoolAddressBox" IsReadOnly="True"
                           PlaceholderText="자동 입력"/>
                </StackPanel>
              </Grid>

              <!-- 학교 선택 완료 표시 -->
              <Border x:Name="SchoolInfoBar" IsVisible="False"
                      Background="#E8F5E9" CornerRadius="4" Padding="10,6">
                <TextBlock Text="✅ 학교가 선택되었습니다." FontSize="12" Foreground="#2E7D32"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ════════ 2단계: 사용자 정보 ════════ -->
        <StackPanel Spacing="10">
          <TextBlock Text="2단계: 사용자 정보" FontSize="16" FontWeight="SemiBold"/>
          <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel Spacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="이름 *" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBox x:Name="UserNameBox" PlaceholderText="이름을 입력하세요"
                         TextChanged="OnUserNameChanged"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="연락처 (선택)" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <TextBox x:Name="UserPhoneBox" PlaceholderText="010-1234-5678"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="이메일 (선택)" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <TextBox x:Name="UserEmailBox" PlaceholderText="teacher@school.kr"/>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="담당 교과 (선택)" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <ComboBox x:Name="UserSubjectCombo" HorizontalAlignment="Stretch">
                  <ComboBoxItem>국어</ComboBoxItem>
                  <ComboBoxItem>영어</ComboBoxItem>
                  <ComboBoxItem>수학</ComboBoxItem>
                  <ComboBoxItem>과학</ComboBoxItem>
                  <ComboBoxItem>사회</ComboBoxItem>
                  <ComboBoxItem>역사</ComboBoxItem>
                  <ComboBoxItem>도덕</ComboBoxItem>
                  <ComboBoxItem>체육</ComboBoxItem>
                  <ComboBoxItem>음악</ComboBoxItem>
                  <ComboBoxItem>미술</ComboBoxItem>
                  <ComboBoxItem>기술가정</ComboBoxItem>
                  <ComboBoxItem>정보</ComboBoxItem>
                  <ComboBoxItem>한문</ComboBoxItem>
                  <ComboBoxItem>제2외국어</ComboBoxItem>
                  <ComboBoxItem>기타</ComboBoxItem>
                </ComboBox>
              </StackPanel>

              <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      CornerRadius="4" Padding="10,6">
                <TextBlock Text="ℹ 사용자 ID는 자동으로 생성됩니다." FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ════════ 3단계: 학년도/학기 ════════ -->
        <StackPanel Spacing="10">
          <TextBlock Text="3단계: 학년도/학기 설정" FontSize="16" FontWeight="SemiBold"/>
          <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="학년도 *" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <NumericUpDown x:Name="WorkYearBox"
                                 Minimum="2020" Maximum="2100" Increment="1"
                                 FormatString="0"
                                 ValueChanged="OnWorkYearChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="학기 *" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <ComboBox x:Name="WorkSemesterCombo" HorizontalAlignment="Stretch"
                            SelectionChanged="OnWorkSemesterChanged">
                    <ComboBoxItem Tag="1">1학기</ComboBoxItem>
                    <ComboBoxItem Tag="2">2학기</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="담임 학년 (선택)" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <NumericUpDown x:Name="HomeGradeBox"
                                 Minimum="1" Maximum="6" Increment="1"
                                 FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="담임 반 (선택)" FontSize="11"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                  <NumericUpDown x:Name="HomeRoomBox"
                                 Minimum="1" Maximum="20" Increment="1"
                                 FormatString="0"/>
                </StackPanel>
              </Grid>

              <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                      CornerRadius="4" Padding="10,6">
                <TextBlock Text="ℹ 담임 학년/반은 나중에 설정에서 변경할 수 있습니다."
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 진행 상태 -->
        <Border Background="#5B7FB8" CornerRadius="4" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="설정 진행 상황" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="Step1Status" Text="□ 학교 선택"
                       FontFamily="Consolas" Foreground="White"/>
            <TextBlock x:Name="Step2Status" Text="□ 사용자 정보"
                       FontFamily="Consolas" Foreground="White"/>
            <TextBlock x:Name="Step3Status" Text="□ 학년도/학기"
                       FontFamily="Consolas" Foreground="White"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ── 오류 + 버튼 ────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
      <TextBlock Grid.Column="0" x:Name="ErrorText"
                 FontSize="12" Foreground="#D9372A"
                 VerticalAlignment="Center" TextWrapping="Wrap"
                 IsVisible="False"/>
      <Button Grid.Column="1" Content="취소"
              Padding="16,8" Margin="0,0,6,0"
              Click="OnCancel"/>
      <Button Grid.Column="2" x:Name="CompleteButton"
              Content="완료" Classes="accent"
              Padding="16,8"
              IsEnabled="False"
              Click="OnComplete"/>
    </Grid>

  </Grid>
</Window>
