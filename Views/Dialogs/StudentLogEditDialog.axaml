<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:SaemDesk.Views.Controls"
        x:Class="SaemDesk.Views.Dialogs.StudentLogEditDialog"
        Title="활동 기록"
        Width="660" Height="690"
        MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">

  <Border Padding="20"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 헤더 -->
      <Border Grid.Row="0" Margin="0,0,0,14"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1" Padding="0,0,0,12">
        <StackPanel Spacing="4">
          <TextBlock x:Name="TitleText" FontSize="15"
                     Foreground="{DynamicResource SystemBaseMediumColor}"/>
          <TextBlock x:Name="SubTitleText"
                     FontSize="22" FontWeight="Bold"/>
        </StackPanel>
      </Border>

      <!-- 폼 — StudentLogBox 재사용 -->
      <ctrl:StudentLogBox x:Name="LogBox" Grid.Row="1"/>

      <!-- 버튼 바 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="8" Margin="0,14,0,0">
        <Button Content="취소" Classes="btn-md" Click="OnCancel"/>
        <Button x:Name="SaveButton" Content="저장" Classes="accent btn-md"
                Click="OnSave"/>
      </StackPanel>

    </Grid>
  </Border>
</Window>
