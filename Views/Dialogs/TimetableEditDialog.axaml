<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SaemDesk.Views.Dialogs.TimetableEditDialog"
        Title="시간표 편집"
        Width="440" Height="420"
        MinWidth="400" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- ── 헤더 ──────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="2">
      <TextBlock x:Name="TitleText"
                 FontSize="18"
                 FontWeight="SemiBold"/>
      <TextBlock x:Name="SubTitleText"
                 FontSize="13"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- ── 폼 ────────────────────────────────────────────── -->
    <StackPanel Grid.Row="1" Spacing="12">

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <Grid.Styles>
          <Style Selector="TextBlock.lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,10"/>
            <Setter Property="FontSize" Value="13"/>
          </Style>
          <Style Selector="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
          </Style>
          <Style Selector="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
          </Style>
          <Style Selector="NumericUpDown">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
          </Style>
        </Grid.Styles>

        <!-- 요일 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="요일" Classes="lbl"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="DayCombo">
          <ComboBoxItem>월요일</ComboBoxItem>
          <ComboBoxItem>화요일</ComboBoxItem>
          <ComboBoxItem>수요일</ComboBoxItem>
          <ComboBoxItem>목요일</ComboBoxItem>
          <ComboBoxItem>금요일</ComboBoxItem>
        </ComboBox>

        <!-- 교시 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="교시" Classes="lbl"/>
        <NumericUpDown Grid.Row="1" Grid.Column="1"
                       x:Name="PeriodBox"
                       Minimum="1" Maximum="10"
                       Increment="1"
                       FormatString="0"
                       Value="1"/>

        <!-- 과목 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="과목" Classes="lbl"/>
        <TextBox   Grid.Row="2" Grid.Column="1"
                   x:Name="SubjectBox"
                   PlaceholderText="예) 국어, 수학"/>

        <!-- 교사 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="교사" Classes="lbl"/>
        <TextBox   Grid.Row="3" Grid.Column="1"
                   x:Name="TeacherBox"
                   PlaceholderText="예) 홍길동"/>

        <!-- 강의실 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="강의실" Classes="lbl"/>
        <TextBox   Grid.Row="4" Grid.Column="1"
                   x:Name="RoomBox"
                   PlaceholderText="예) 1-3 교실 (선택)"/>
      </Grid>

      <!-- 오류 메시지 -->
      <TextBlock x:Name="ErrorText"
                 IsVisible="False"
                 Foreground="{DynamicResource SystemErrorTextColor}"
                 FontSize="12"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <!-- ── 버튼 바 ───────────────────────────────────────── -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button x:Name="CancelButton"
              Content="취소"
              Padding="16,8"
              Click="OnCancel"/>
      <Button x:Name="SaveButton"
              Content="저장"
              Classes="accent"
              Padding="16,8"
              Click="OnSave"/>
    </StackPanel>

  </Grid>
</Window>
