<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SaemDesk.Views.Controls"
        x:Class="SaemDesk.Views.Dialogs.StudentDetailDialog"
        Title="학생 상세"
        Width="800" Height="680"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- 헤더: 학년 반 번 이름 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="2">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="SubTitleText" FontSize="13"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
    </StackPanel>

    <!-- 탭 -->
    <TabControl Grid.Row="1">

      <!-- ── 학생 정보 ─────────────────────────────────── -->
      <TabItem Header="학생 정보">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,4">
          <ctrl:StudentCard x:Name="CardControl" IsEnabled="False"/>
        </ScrollViewer>
      </TabItem>

      <!-- ── 활동 기록 ─────────────────────────────────── -->
      <TabItem Header="활동 기록">
        <Grid RowDefinitions="Auto,*" Margin="4,8,4,4">

          <!-- 건수 표시 -->
          <TextBlock Grid.Row="0"
                     x:Name="LogCountText"
                     FontSize="12"
                     Foreground="{DynamicResource SystemBaseMediumColor}"
                     Margin="0,0,0,8"/>

          <!-- LogListViewer -->
          <ctrl:LogListViewer Grid.Row="1" x:Name="LogViewer"/>

        </Grid>
      </TabItem>

    </TabControl>

    <!-- 닫기 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="닫기" Classes="btn-md" Click="OnClose"/>
    </StackPanel>

  </Grid>
</Window>
