<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:SaemDesk.Views.Controls"
        x:Class="SaemDesk.Views.Dialogs.CourseEnrollmentDialog"
        Title="수강생 관리"
        Width="860" Height="720"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

    <!-- ── 안내/오류 메시지 ────────────────────────────── -->
    <Border x:Name="InfoBar" Grid.Row="0" IsVisible="False"
            CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
      <TextBlock x:Name="InfoBarText" FontSize="12" TextWrapping="Wrap"/>
    </Border>

    <!-- ── 과목 정보 헤더 ─────────────────────────────── -->
    <Border Grid.Row="1"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="TxtSubject" Text="과목명"
                     FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource SecondaryAccentBrush}" CornerRadius="4" Padding="8,2">
            <TextBlock x:Name="TxtType" Text="학급 공통"
                       FontSize="12" Foreground="White"/>
          </Border>
          <TextBlock x:Name="TxtGradeInfo" Text="1학년" FontSize="13"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="TxtEnrolledCount"
                   Text="등록: 0명" FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ── 일괄 배치 바 (학급 공통 전용) ─────────────── -->
    <Border Grid.Row="2" x:Name="BulkAssignPanel" IsVisible="False"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="⚡ 일괄 배치:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtBulkDesc" FontSize="13" VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Button Content="전체 학생 일괄 배치" Classes="accent" Padding="12,5"
                Click="BtnBulkAssign_Click"/>
      </StackPanel>
    </Border>

    <!-- ── 학생 목록 영역 ──────────────────────────────── -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*">

      <!-- 좌: 학급 학생 -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                Padding="12,8" CornerRadius="8,8,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,1,1,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="학급 학생" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="TxtAvailableCount" FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- 필터: 학년/반 -->
        <Border Grid.Row="1" Padding="8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,0,1,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ComboBox x:Name="CBoxGradeFilter" MinWidth="80"
                      SelectionChanged="CBoxGradeFilter_SelectionChanged"/>
            <ComboBox x:Name="CBoxClassFilter" MinWidth="80"
                      SelectionChanged="CBoxClassFilter_SelectionChanged"/>
          </StackPanel>
        </Border>

        <!-- 학생 목록 + 빈 상태 오버레이 -->
        <Panel Grid.Row="2">
          <ctrl:ListStudent x:Name="ListAvailable" ViewMode="NumName" ShowCheckBox="True"/>
          <Border x:Name="EmptyAvailable" IsVisible="False"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <TextBlock Text="배정 가능한 학생이 없습니다"
                         FontSize="13" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
          </Border>
        </Panel>
      </Grid>

      <!-- 중앙: 이동 버튼 -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Spacing="8">
        <Button Content="▶" ToolTip.Tip="선택한 학생 등록"
                Padding="12,8" Click="BtnAdd_Click"/>
        <Button Content="◀" ToolTip.Tip="선택한 학생 제거"
                Padding="12,8" Click="BtnRemove_Click"/>
      </StackPanel>

      <!-- 우: 수강생 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                Padding="12,8" CornerRadius="8,8,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,1,1,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="✅ 수강생" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="TxtRegisteredCount" FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- 강의실 필터 + 검색 -->
        <Border Grid.Row="1" Padding="8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,0,1,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <ComboBox Grid.Column="0" x:Name="CBoxRoomFilter"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="CBoxRoomFilter_SelectionChanged"/>
            <TextBox  Grid.Column="1" x:Name="TxtSearch"
                      PlaceholderText="이름 검색..."
                      TextChanged="TxtSearch_TextChanged"/>
          </Grid>
        </Border>

        <!-- 수강생 목록 + 빈 상태 오버레이 -->
        <Panel Grid.Row="2">
          <ctrl:ListStudent x:Name="ListEnrolled" ViewMode="ClassNumName" ShowCheckBox="True"/>
          <Border x:Name="EmptyEnrolled" IsVisible="False"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <TextBlock Text="등록된 수강생이 없습니다"
                         FontSize="13" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
              <TextBlock Text="좌측에서 학생을 선택해 ▶ 버튼으로 추가하세요"
                         FontSize="11" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            </StackPanel>
          </Border>
        </Panel>
      </Grid>
    </Grid>

    <!-- ── 버튼 바 ────────────────────────────────────── -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="취소" Click="OnCancel"/>
      <Button Content="저장" Classes="accent" Click="OnSave"/>
    </StackPanel>

  </Grid>
</Window>
