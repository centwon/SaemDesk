<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SaemDesk.Views.Dialogs.SeatExclusionDialog"
        Title="짝 설정"
        Width="480" Height="500"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

    <!-- 학생 A/B 선택 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,8">
      <ComboBox Grid.Column="0" x:Name="StudentABox"
                PlaceholderText="학생 A" HorizontalAlignment="Stretch"/>
      <ComboBox Grid.Column="1" x:Name="StudentBBox"
                PlaceholderText="학생 B" HorizontalAlignment="Stretch"/>
    </Grid>

    <!-- 추가 버튼 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" Margin="0,0,0,12">
      <Button Content="🚫 분리 추가" Padding="12,6"
              ToolTip.Tip="이 두 학생을 짝으로 배치하지 않음"
              Click="OnAddExclusion"/>
      <Button Content="📌 고정 추가" Padding="12,6"
              ToolTip.Tip="이 두 학생을 반드시 짝으로 배치"
              Click="OnAddFixed"/>
    </StackPanel>

    <!-- 설정 목록 -->
    <Grid Grid.Row="2">
      <ListBox x:Name="PairListView" Background="Transparent" BorderThickness="0"
               SelectionMode="Single"/>
      <TextBlock x:Name="EmptyMessage"
                 Text="설정된 짝 조건이 없습니다."
                 FontSize="12"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <!-- 닫기 버튼 -->
    <Button Grid.Row="3" Content="닫기" HorizontalAlignment="Right"
            Padding="16,8" Margin="0,12,0,0" Click="OnClose"/>

  </Grid>
</Window>
