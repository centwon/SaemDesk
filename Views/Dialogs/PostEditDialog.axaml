<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SaemDesk.Views.Controls"
        x:Class="SaemDesk.Views.Dialogs.PostEditDialog"
        Title="게시글 작성"
        Width="900" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

    <!-- 헤더 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="2">
      <TextBlock x:Name="TitleText"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Text="게시글 작성"/>
      <TextBlock x:Name="SubTitleText"
                 FontSize="12"
                 Foreground="{DynamicResource SystemBaseMediumColor}"
                 Text="제목 · 카테고리 · 본문을 입력하세요."/>
    </StackPanel>

    <!-- 메타 입력 -->
    <Grid Grid.Row="1"
          ColumnDefinitions="Auto,160,Auto,*,Auto,180"
          Margin="0,0,0,8">

      <TextBlock Grid.Column="0"
                 Text="카테고리"
                 VerticalAlignment="Center"
                 FontSize="13"
                 Margin="0,0,8,0"/>
      <TextBox Grid.Column="1"
               x:Name="CategoryBox"
               PlaceholderText="예) 업무"
               FontSize="13"/>

      <TextBlock Grid.Column="2"
                 Text="제목"
                 VerticalAlignment="Center"
                 FontSize="13"
                 Margin="16,0,8,0"/>
      <TextBox Grid.Column="3"
               x:Name="TitleBox"
               PlaceholderText="제목을 입력하세요"
               FontSize="13"/>

      <TextBlock Grid.Column="4"
                 Text="작성자"
                 VerticalAlignment="Center"
                 FontSize="13"
                 Margin="16,0,8,0"/>
      <TextBox Grid.Column="5"
               x:Name="UserBox"
               PlaceholderText="이름"
               FontSize="13"/>
    </Grid>

    <!-- 에디터 -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource ContentSeparatorBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,4,0,0">
      <controls:JoditEditor x:Name="Editor"
                            Mode="Full"/>
    </Border>

    <!-- 버튼 바 -->
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <TextBlock x:Name="StatusText"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"
                 FontSize="12"
                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
      <Button x:Name="CancelButton"
              Content="취소"
              Classes="btn-md"
              Click="OnCancel"/>
      <Button x:Name="SaveButton"
              Content="저장"
              Classes="accent btn-md"
              Click="OnSave"/>
    </StackPanel>

  </Grid>
</Window>
