<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bpages="using:SaemDesk.Board.Views.Pages"
        x:Class="SaemDesk.Views.Dialogs.PostDetailDialog"
        Title="게시글 보기"
        Width="900" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid Margin="16">
    <!-- 상세/수정은 같은 창 안에서 교체 (BoardPage 와 동일 패턴) -->
    <bpages:PostDetailPage x:Name="DetailPage"/>
    <bpages:PostEditPage   x:Name="EditPage" IsVisible="False"/>
  </Grid>
</Window>
