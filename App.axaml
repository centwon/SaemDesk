<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaemDesk.App"
             xmlns:local="clr-namespace:SaemDesk"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <semi:SemiTheme Locale="ko-KR"/>
    <StyleInclude Source="avares://SaemDesk/Assets/Styles/CommonStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SaemDesk/Assets/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- DatePicker 전역 너비 제한 해제: MinWidth=0 설정 후 Width 직접 지정 가능 -->
      <x:Double x:Key="DatePickerThemeMinWidth">0</x:Double>
      <x:Double x:Key="DatePickerThemeMaxWidth">9999</x:Double>
    </ResourceDictionary>
  </Application.Resources>
</Application>
